    { "sigla": "SDA", "nome": "Sistema de Apostas", "descricao": "Permite que espectadores apostem pontos nas batalhas do LDI. O vencedor recebe até 10% dos pontos apostados. Uma das fontes de renda dos jogadores de alto ranking.", "premium": true },
