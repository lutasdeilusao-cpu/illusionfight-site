            "nome": "El Callejón de los Gatos",
            "sub": "donde se esconde la banda del cableado",
            "fala": [
              "¿Tocaste nuestro tablero? Acá nadie toca nuestra luz.",
              "Los Gatos viven a oscuras, pibe. Vení a aprender cómo es."
            ]
          },
          "balanca": {
            "nome": "La balanza trucada",
            "sub": "el peso del Turco siempre gana",
            "fala": [
              "Acá el que pesa soy yo. Y te pesé: debés.",
              "Cada puesto paga el peso que yo digo."
            ]
          },
          "caderneta_viva": {
            "nome": "El Libreta",
            "sub": "recuerda cada centavo",
            "fala": [
              "Sé el nombre de cada deudor de Marélia. Y el tuyo está acá.",
              "El que debe cobra con intereses."
            ]
          },
          "mao_turco": {
            "nome": "La Mano del Turco",
            "sub": "el brazo que cobra",
            "fala": [
              "La radio pirata habló de mí, ¿no? Entonces sabés quién soy.",
              "Soy la mano que usa el Turco para cerrar la cuenta."
            ]
          },
          "caixa_forte": {
            "nome": "La Caja Fuerte",
            "sub": "la caja de la Feria tiene piernas",
            "fala": [
              "Todo lo que paga la Feria pasa por mí.",
              "¿Querés la plata? Vení a sacarla de la caja."
            ]
          },
          "radio": {
            "nome": "Toninho de la Radio",
            "sub": "arregla todo lo que chisporrotea",
            "fala": [
              "Esta radio agarra la frecuencia del Ajuste de Cuentas — los del Turco hablan todo por ahí.",
              "Solo que se quemó. Traeme 1 cable de cobre y 3 válvulas y la hago hablar."
            ],
            "escolhas": {
              "consertar": {
                "label": "Entrega el cobre y las 3 válvulas",
                "resultado": "Toninho suelda, sopla, gira la perilla... y la radio larga una voz: \"La Mano y la Caja Fuerte están en la Feria hoy.\" Ahora sabés dónde están."
              }
            }
          },
          "camelo": {
            "nome": "El Vendedor Ambulante",
            "sub": "un poco de todo, y más barato si sabés hablar"
          },
          "muamba": {
            "nome": "El Contrabando del Domingo",
            "sub": "cruza la Feria sin que la Redada te vea",
            "intro": "Llevá el contrabando de una punta a la otra de la Feria. La Redada está rondando y el tiempo corre — si te ven, perdés todo."
          },
          "favor_marmita": {
            "nome": "La vianda de Regina",
            "sub": "favor para Doña Regina",
            "intro": "Doña Regina pidió: lleva la vianda de su hijo al otro lado de la Feria sin que la Redada la confisque. Favor pagado es fiado liberado."
          },
          "favor_devedor": {
            "nome": "Números Rojos",
            "sub": "le debe a Doña Regina hace meses",
            "fala": [
              "¿Qué? ¿Regina te mandó? Pago la semana que viene, lo juro.",
              "La semana que viene, igual que la semana pasada."
            ],
            "escolhas": {
              "convence": {
                "label": "Convencelo hablando",
                "resultado": "Se rasca la cabeza, suspira y le paga a Regina. \"Está bien, está bien. Ella siempre me dio de comer.\""
              },
              "aperta": {
                "label": "Apretalo",
                "resultado": "Retrocede y llama a sus amigos. \"¿Viniste a cobrar con la mano? Entonces cobrá con la mano.\""
              }
            }
          },
          "favor_cobrador": {
            "nome": "El cobrador de la pensión",
            "sub": "está presionando a Doña Regina",
            "fala": [
              "La vieja le debe al Turco. Quítate del medio.",
              "¿Querés pagar por ella? Pagá con los huesos."
            ]
          },
          "pagina_1": {
            "nome": "Página rota",
            "sub": "de la libreta del Turco",
            "linha": "Pegada al piso de un puesto: una página de la libreta del Turco, llena de nombres y números. Hay más por ahí."
          },
          "pagina_2": {
            "nome": "Otra página",
            "sub": "de la libreta del Turco",
            "linha": "En el lado apagado, doblada en un cajón: otra página de la libreta. Tiene una nota del Cobrador en el margen."
          },
          "pagina_3": {
            "nome": "La última página",
            "sub": "de la libreta del Turco",
            "linha": "Escondida en la Galería de los Gatos: la última página. Juntas, muestran dónde el Cobrador es débil — baja la guardia cuando cobra."
          },
          "radio_pirata": {
            "nome": "La radio pirata",
            "sub": "la frecuencia del Ajuste de Cuentas",
            "fala": [
              "La radio chisporrotea en un rincón del taller. Entre ruido y ruido, una voz habla de la Bajada.",
              "\"...allá abajo manda el Perfora-Tripas. Quien quiera llegar a él tiene que escuchar antes...\""
            ],
            "escolhas": {
              "ouvir": {
                "label": "Escuchá toda la frecuencia",
                "resultado": "Anotás todo lo que dijo la radio sobre la Bajada. Cuando llegue la hora, ya sabés por dónde entrar."
              }
            }
          },
          "pensao": {
            "nome": "Pensión de Doña Regina",
            "sub": "comida caliente y cama limpia",
            "intro": "Doña Regina sirve un plato de comida y acomoda a la banda en un rincón. Cuesta unas monedas — y si no tenés plata, ella lo resuelve de otra forma.",
            "favor_pedir": "Sin plata — pide fiado a cambio de un favor",
            "favor_pendente": "Todavía le debés un favor a Regina",
            "favor_fala": "\"Comé, pibe. Después me hacés un favor — la Feria está llena de gente que me debe.\""
          },
          "pensao_2": {
            "nome": "Pensión de la hija",
            "sub": "la hija de Regina, del lado apagado",
            "intro": "La hija de Doña Regina lleva una pensión del lado oscuro, a luz de vela. La misma regla de la madre: pagas unas monedas y la banda se arregla.",
            "favor_pedir": "Sin plata — pide fiado a cambio de un favor",
            "favor_pendente": "Todavía le debés un favor a Regina",
            "favor_fala": "\"Mi mamá me habló de vos. Comé — el favor lo arreglás con ella.\""
          },
          "juro_alto": {
            "nome": "Interés Alto",
            "sub": "presta mucho, cobra mucho más",
            "fala": [
              "¿Necesitás plata grande, pibe? Yo no trabajo con monedas.",
              "300 en la mano ahora. Pero la cuenta... la cuenta es mía."
            ],
            "botao_ver_contrato": "Quiero los 300",
            "contrato_tag": "Contrato · interés alto",
            "contrato_corpo": "\"300 en la mano, ya. ¿Aceptas o no aceptas?\"",
            "contrato_letra_miuda": "Letra chica del contrato: quedas debiendo {divida}.",
            "contrato_aceitar": "Acepto",
            "contrato_recusar": "No acepto"
          },
          "deposito_1": {
            "nome": "La puerta del depósito",
            "sub": "Interés Alto y sus matones",
            "fala": [
              "De acá en adelante es el Mercadón. Nadie pasa sin pagar.",
              "Y no te alcanza para lo que cobramos."
            ]
          },
          "deposito_2": {
            "nome": "El guardia del Mercadón",
            "sub": "solo abre para quien tiene nombre",
            "fala": [
              "¿Tenés nombre en la Feria? Entonces probalo.",
              "El Turco solo recibe a quien la calle respeta."
            ]
          },
          "rinha_apostas": {
            "nome": "Riña de Apuestas",
            "sub": "apuesta y pelea sin fin — la apuesta vale en la 1ª",
            "fala": [
              "Acá a oscuras la rueda gira con plata en la mesa.",
              "Poné tu apuesta y entrá. Ganás, te llevás el doble. Perdés, te quedás sin nada.",
              "La rueda no para: termina una, ya entra otro, sorteado. Podés dejar a la banda acá — 1 pelea cada 5 minutos."
            ]
          },
          "mercearia": {
            "nome": "Almacén de Don Aziz"
          },
          "serralheria": {
            "nome": "Herrería del Bigote",
            "fala": "Nando hace el primer ajuste. Yo voy hasta el final: trae la pieza y chatarra y la dejo pegando firme siempre."
          },
          "galeria": {
            "m1": {
              "nome": "Vigía de los Gatos",
              "fala": [
                "¿Entraste a la Galería? Esta es la casa de los Gatos, pibe.",
                "Nadie cruza sin pagar peaje."
              ]
            },
            "porta": {
              "nome": "La puerta de los Gatos",
              "sub": "cerrada con su código",
              "intro": "Una puerta de hierro con candado de código. Los Gatos cambian la clave cada semana — descifrá el código para pasar. Si le errás, vienen a ver quién la tocó."
            },
            "m2": {
              "nome": "Los Gatos del medio",
              "fala": [
                "¿Abriste nuestra puerta? Ahora estás encerrado acá con nosotros.",
                "A oscuras vemos mejor que vos."
              ]
            },
            "m3": {
              "nome": "Vigía de la salida",
              "fala": [
                "Casi saliendo, ¿no? Casi.",
                "La luz está del otro lado de mí."
              ]
            }
          },
          "mercadao": {
            "m2": {
              "nome": "Mazo",
              "fala": [
                "La cámara fría es lugar de carne quieta. Vos te quedás acá.",
                "Yo cuido lo que es del Turco. Vos no pasás."
              ]
            },
            "achado": {
              "nome": "El stock escondido",
              "sub": "lo que el Turco guarda para él",
              "linha": "Detrás de las cajas de mercancía: plata, chatarra y una buena pieza. El Turco no lo va a notar — nunca cuenta su propio stock."
            },
            "livro_caixa": {
              "nome": "El libro de caja",
              "sub": "la cuenta de toda la Feria",
              "fala": [
                "Sobre la mesa, el libro de caja del Turco. Cada puesto, cada deudor, cada centavo.",
                "En la última hoja, una nota del Cobrador: \"cuando cobro, bajo la guardia\"."
              ],
              "escolhas": {
                "ler": {
                  "label": "Leelo todo",
                  "resultado": "Cerrás el libro. Si juntás las 3 páginas de la libreta, el Cobrador entra a la pelea con la guardia baja."
                }
              }
            },
            "barraca_1": {
              "nome": "El dueño del primer puesto",
              "fala": [
                "Entraste al Mercadón por el pasillo equivocado, pibe. Acá cada puesto es del Turco.",
                "¿Querés pasar? Pagá el peaje de la lona — con los huesos."
              ]
            },
            "barraca_2": {
              "nome": "La banda de las empanadas",
              "fala": [
                "¡Epa, epa, epa! ¡Llamen a la muchachada, hay un intruso entre los puestos!",
                "Acá adentro peleamos en banda, pibe. Solo no salís."
              ]
            },
            "barraca_3": {
              "nome": "El vigía de las lonas",
              "fala": [
                "Este laberinto se armó para que nadie encuentre la caja fuerte.",
                "Y el que la encuentra, antes cobra de mí."
              ]
            },
            "barraca_4": {
              "nome": "El fiscal del pasillo",
              "fala": [
                "Cada puesto que pasás es una deuda que hacés, ¿sabías?",
                "Esta te la cobro ahora."
              ]
            },
            "barraca_5": {
              "nome": "La plaza de los cobradores",
              "fala": [
                "Llegaste lejos, ¿eh? Todos los cobradores del Turco juntos acá.",
                "De acá en adelante solo pasa el que salda la cuenta."
              ]
            },
            "barraca_6": {
              "nome": "El último de la fila",
              "fala": [
                "Después de mí solo quedan Mazo y la caja fuerte.",
                "Y no vas a ver a ninguno de los dos."
              ]
            }
          }
        },
        "briga_auto": "Pelea auto",
        "briga_auto_aviso": {
          "titulo": "PELEA AUTO // TE CHOCASTE, SE ARMÓ",
          "frases": [
            "¿Buscabas bardo? Ahí lo tenés. ¡Bancátela!",
            "¿Viniste agrandado? Ahora demostralo.",
            "Uh, qué mufa: su barra ya te está rodeando.",
            "Nada de arrugar, pibe — ahora es a las piñas.",
            "Te chocaste con el pesado equivocado, pibe. ¡Metele con todo!",
            "No queda para dónde rajar. ¡A los bifes!",
            "Uy… este no vino a charlar. Vas a tener que ir con todo.",
            "Querías quilombo. El quilombo te encontró."
          ]
        }
      },
      "enemy_album": {
        "1701": "Maneja la moto del asalto. No se baja, solo acelera — el que se baja es el de atrás.",
        "1702": "Va atrás y anuncia el asalto. \"Todos estamos expuestos.\"",
        "1711": "Hace la ronda de la madrugada. Requisa a cualquiera que siga en la calle después de las diez.",
        "1712": "Comanda el patrullero. No quiere explicaciones, quiere documentos.",
        "1101": "No pelea, corre y avisa — enfrentarlo es una persecución antes de la paliza.",
        "1102": "El ojo de la esquina — ve todo lo que sube y baja la Pista, y lo comenta todo.",
        "1103": "El más rápido de la Pista — huye si recibe 2 golpes seguidos.",
        "1104": "Uno de los Gatos más audaces, conecta hasta un poste vigilado.",
        "1105": "Un deudor vuelto matón para pagar su propia deuda.",
        "1106": "Descarga leve, aturde — la alarma viva del Mercado.",
        "1107": "El más joven de los pedazos, aún probando su valor.",
        "1108": "Ataca al ritmo del tren que pasa.",
        "1109": "Esparce rumores del rival antes de pelear.",
        "1110": "Vigila la entrada, avisa a toda la banda.",
        "1111": "Patrulla la escalera sin luz, usa la linterna como arma.",
        "1112": "Pelea por cualquier tontería, siempre alerta.",
        "1113": "Ataca de lejos antes de que te acerques.",
        "1114": "Lanza dos a la vez, impredecible.",
        "1115": "Conoce todo pasaje oculto del Cerro.",
        "1116": "Guardia literal de la entrada, no deja el puesto.",
        "1117": "Guarda la sala privada de los Cinco.",
        "1118": "Le debe al Contador, pelea para pagar.",
        "1119": "Último escalón antes del taller — nada pasa sin ser visto.",
        "1120": "Ve todo lo que entra y sale de la Azotea, reporta al Retazo.",
        "1121": "Divisa toda Marélia antes de que llegue cualquier ataque.",
        "1201": "Chicos de esquina — la primera pelea de verdad.",
        "1202": "Copiaba a Carbón hasta que el apodo se le pegó.",
        "1203": "Pelea sucia, golpes rápidos, poco daño.",
        "1204": "Hace conexiones clandestinas de luz — se pierde entre los puestos.",
        "1205": "Atiende el puesto de día, cobra de noche.",
        "1206": "Cobra una deuda vieja que sólo él recuerda.",
        "1207": "Devoto del Sombra muerto, aún \"habla con él\".",
        "1208": "Recicla armas de chatarra — daño impredecible.",
        "1209": "Vive cerca de donde cayó el Sombra, los demás lo evitan.",
        "1210": "Estrangula con cuerda de tendedero, arma improvisada.",
        "1211": "Acceso a cada piso, información valiosa.",
        "1212": "Infiltrado — parece un vecino común.",
        "1213": "Usa la pendiente del Cerro como arma.",
        "1214": "Albañil improvisado, herramienta como arma.",
        "1215": "Uno de los chicos que crió, técnica prestada.",
        "1216": "Siempre pelea en pareja, nunca solo.",
        "1217": "Castiga a quien rompe la formación de la Rueda.",
        "1218": "Recluta y entrena para los Cinco.",
        "1219": "Recién reclutado, aún probándose ante la banda.",
        "1220": "El único punto de venta en la cima — pequeño, simbólico.",
        "1221": "Vende lo que sobra del taller — retazo literal.",
        "1301": "Agresivo, un escalón sobre los chicos comunes.",
        "1302": "Cicatrices de los que perdieron con él — trofeos de guerra.",
        "1303": "Roba lo que ve, no suelta lo que agarra.",
        "1304": "Cobrador de calle — pega antes de que el jefe cobre en serio.",
        "1305": "Sabe lo que debe cada vecino, lo usa como arma psicológica.",
        "1306": "\"Pesa\" todo — gente incluida, literalmente.",
        "1307": "Se dice sucesor legítimo, nadie lo reconoce.",
        "1308": "El pedazo más bravo de los tres del Sombra.",
        "1309": "El pedazo calculador — no falla.",
        "1310": "Controla la planta baja.",
        "1311": "Manda un piso entero.",
        "1312": "Sólo ataca en espacio cerrado, pelea sucia de pasillo.",
        "1313": "Vigía de la escalera con autoridad sobre la subida.",
        "1314": "Capitán — subió rápido, pega más fuerte que nadie.",
        "1315": "Guarda la última curva antes del Alto del Cerro.",
        "1316": "Uno de los cinco que casi forman cúpula.",
        "1317": "Mano derecha de la cúpula casi formada.",
        "1318": "Pelea en formación, protege el centro.",
        "1319": "Primera línea de la banda del Retazo.",
        "1320": "Segunda línea, confianza de media Azotea.",
        "1321": "General más antiguo, sin movimiento de más.",
        "1401": "Vendedor de caramelos con una piedra en el bolsillo.",
        "1402": "Cobra hasta la última moneda, nunca falla la cuenta.",
        "1403": "Brazo de confianza, cobra deudas grandes sin charla.",
        "1404": "Duplica la deuda si vence el plazo.",
        "1405": "El pedazo más desesperado — nada que perder.",
        "1406": "Cobra en nombre de los tres pedazos a la vez.",
        "1407": "Mira a la banda de arriba abajo.",
        "1408": "Cobra el \"alquiler\" que la banda impone en cada piso.",
        "1409": "Lanza aviso, no le importa acertarte.",
        "1410": "Lleva las cuentas de quien le debe favores a Zefa.",
        "1411": "El más ambicioso de los Cinco.",
        "1412": "Trabaja directo para el Contador.",
        "1413": "Pocos ataques, pero certeros.",
        "1414": "Cierra la cuenta de quien sube sin pagar peaje.",
        "1451": "Manda a todos los vigías — si silba, el barrio corre.",
        "1452": "La más veterana de la Banda de la Señal, entrenó a los chicos.",
        "1453": "La mano derecha del Cobrador, resuelve lo que él no ensucia.",
        "1454": "Guarda el dinero de todo el Mercado.",
        "1455": "El pedazo más respetado, casi reunifica la Bajada solo.",
        "1456": "Usa el nombre del jefe muerto como arma.",
        "1457": "Maneja un edificio entero solo.",
        "1458": "Acceso a cada piso — información que vale más que dinero.",
        "1459": "Cuida a los niños cuando Zefa no puede.",
        "1460": "Controla la subida solo, nadie pasa sin permiso.",
        "1461": "Uno de los Cinco más cerca de una silla en la cúpula.",
        "1462": "Dirige la Rueda en batalla — la doctrina hecha cuerpo.",
        "1463": "General — manda toda la Azotea por el Retazo.",
        "1464": "Mano derecha de Tijera, nunca falla el corte final.",
        "1500": "Se esfuma en plena calle, pega en lo oscuro. Jefe de la Pista.",
        "1501": "Anota todo, cobra todo. Rompe un brazo antes que la cara.",
        "1502": "Se quedó con toda la Bajada cuando el Sombra cayó a la zanja.",
        "1503": "Vive en el décimo piso — llegas ya cansado.",
        "1504": "Crió a la mitad de los niños de la zona. Sabe dónde pegar para doler sin dañar.",
        "1505": "No pelea por rabia — pelea porque la cuenta cuadra así.",
        "1600": "El único que sostuvo seis barrios a la vez."
      },
