    "temas": {
      "acesse": "ACESSE ISSO AQUI",
      "ano_todo": "Essa área fica no ar o ano inteiro, com a Temporada 1 toda liberada pra você, e vai sendo atualizada. Se agora não for o momento de gravar, volta depois: vai ter coisa nova te esperando.",
      "itens": {
        "autor": {
          "nome": "A história do criador",
          "fala": "Isaias Leal passou quase 10 anos na indústria de games, trabalhou em FNAF: Into the Pit e God of War: Sons of Sparta e lançou mais de 50 títulos. Saiu pra construir sozinho um universo que ele escreve desde os 17 anos. Funciona bem pra canal de bastidores, carreira, desenvolvimento independente e pra quem gosta de história de gente que apostou tudo num projeto."
        },
        "personagens": {
          "nome": "A vida dos personagens",
          "fala": "Cada personagem principal tem um passado contado à parte: a Nina, adotada aos 3 anos; o Jack, sozinho desde muito cedo, entregando de bicicleta pra sobreviver. Dá vídeo de análise, de teoria e de \"quem é quem\" antes de começar a ler."
        },
        "contos": {
          "nome": "Um conto pra começar",
          "fala": "Se você quer uma história fechada, pegue um conto. Alan, o Campeão mostra o crime organizado de Marélia. Sonata de uma Briga é curto e direto. As Correntes explica o poder do Kim. Todos estão abertos agora."
        },
        "principal": {
          "nome": "A história principal",
          "fala": "A linha principal é Lutas de Ilusão: Kim, Jack e Nina num mundo onde a luta acontece num simulador e a dor é real. Você tem 12 capítulos do livro e todo o webtoon produzido até o lançamento. Ótimo pra leitura comentada e primeiras impressões."
        },
        "temporada": {
          "nome": "A Temporada 1 e a agenda",
          "fala": "A Season 1 começa em 30 de novembro de 2026, com capítulos saindo em sequência. A cada três meses de lançamentos tem um mês de hiato, o mês de descanso. Nesse mês entra o conteúdo extra do mesmo autor: O Mundo das Sombras e Mar de Cinzas. É por isso que eles existem ao lado da linha principal: sempre tem história nova, e você tem pauta o ano inteiro."
        },
        "games": {
          "nome": "Games",
          "fala": "Três jogos completos e grátis no navegador: LDI Gangues (briga de gangue pela cidade), Lendas do LDI (a sua Veia muda a história) e Super Trunfo com modo online. Bom pra gameplay, desafio com a audiência e cobertura do Steam Next Fest."
        },
        "musica": {
          "nome": "Música",
          "fala": "O universo tem trilha original, tocando na Rádio Nina dentro do site. E tem um conto inteiro sobre a banda do Kim e do Jack. Funciona pra canal de música, react de trilha e live com som de fundo."
        },
        "universo": {
          "nome": "O universo inteiro",
          "fala": "São três universos do mesmo autor: Lutas de Ilusão (ação), O Mundo das Sombras (terror) e Mar de Cinzas (fantasia sombria). Dá vídeo de lore, de comparação e de construção de mundo."
        }
      },
