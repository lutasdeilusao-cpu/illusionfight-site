    "duvidas": {
      "eyebrow": "PERGUNTE À NEOGUIDE",
      "itens": {
        "o_que_e": {
          "p": "O que é o Illusion Fight?",
          "r": "Um universo de ação criado por Isaias Leal. Começou como livro e virou webtoon, jogos e trilha sonora, tudo conectado no site. Tem três universos: Lutas de Ilusão, O Mundo das Sombras e Mar de Cinzas."
        },
        "ano_todo": {
          "p": "A área fica disponível até quando?",
          "r": "O ano inteiro. A Temporada 1 toda fica liberada pra você e a área vai sendo atualizada com capítulos, artes e pautas novas. Pode voltar quando quiser."
        },
        "hiato": {
          "p": "Vai ter pausa nos lançamentos?",
          "r": "Vai. A cada três meses de lançamentos tem um mês de descanso. Nesse mês entram O Mundo das Sombras e Mar de Cinzas, histórias extras do mesmo autor. Ou seja: nunca fica sem conteúdo."
        },
        "gratis": {
          "p": "É de graça pro meu público?",
          "r": "Sim. Os jogos e boa parte das histórias são grátis. Existe uma assinatura opcional que libera os capítulos antes. Você recebe esse acesso antecipado sem pagar nada."
        },
        "posso_falar": {
          "p": "Posso falar mal?",
          "r": "Pode. Crítica é conteúdo. Ninguém aprova nada antes e não existe roteiro."
        },
        "republicar": {
          "p": "O que não posso fazer?",
          "r": "Republicar conteúdo completo: um capítulo inteiro, um episódio inteiro do webtoon ou os arquivos originais. Trechos, prints e até 3 páginas por publicação estão liberados."
        },
        "prazo": {
          "p": "Por quanto tempo tenho acesso?",
          "r": "O tempo aparece no topo da sua mesa. Ele depende do tamanho do canal, de 1 a 6 meses. Dá pra renovar."
        },
        "idiomas": {
          "p": "Em que idiomas está?",
          "r": "Português, inglês e espanhol. Troque o idioma no menu do site e todo o conteúdo acompanha."
        },
        "lancamento": {
          "p": "Quando é o lançamento?",
          "r": "A Season 1 sai em 30 de novembro de 2026. Antes disso, o universo está no Steam Next Fest, de 19 a 26 de outubro."
        },
        "steam": {
          "p": "O que tem na Steam?",
          "r": "A página da Season 1 (app 1876210) e a demo gratuita (app 5188520). Colocar na lista de desejos ajuda muito o projeto."
        },
        "contato": {
          "p": "Como falo com o autor?",
          "r": "Escreve pra lutasdeilusao@gmail.com. Entrevista, dúvida, pedido de arte específica: é só pedir."
        }
      }
