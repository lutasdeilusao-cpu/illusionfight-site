  "glossario": [
    { "sigla": "LDI", "nome": "Lutas de Ilusão", "descricao": "La arena virtual creada por Yohualticit en 2022. Dolor 100% real. Tres mil millones de jugadores. El deporte más visto del mundo en 20XX.", "premium": false },
    { "sigla": "SBI", "nome": "Simulador de Batallas de Ilusión", "descricao": "Hardware que conecta el sistema nervioso al MDI. Compuesto por Immersor (cuerpo), Gafas (inmersión visual) y Guante Tecnológico (movimientos). Las ediciones limitadas cuestan 60–70k unidades.", "premium": false },
    { "sigla": "MDI", "nome": "Mundo de Ilusiones", "descricao": "La dimensión virtual donde se llevan a cabo las batallas del LDI. Construida por Yohualticit. Dentro de ella, las leyes del mundo real se reescriben parcialmente.", "premium": false },
    { "sigla": "MDR", "nome": "Mundo de Realidad", "descricao": "El mundo físico real — fuera del SBI. Aquí es donde Kim vende dulces, paga las facturas y vive con Helena.", "premium": false },
    { "sigla": "SDR", "nome": "Sistema de Desafíos de Clasificación", "descricao": "El sistema de ranking global del LDI. Clasifica a todos los jugadores del mundo por desempeño. Determina ingresos, visibilidad y acceso al Torneo Mundial.", "premium": false },
    { "sigla": "PowWow", "nome": "PowWow", "descricao": "La red social de video corto dominante en 20XX, dedicada al LDI. La pelea Kim vs. Thunderbolt llegó al top 10 mundial el mismo día.", "premium": false },
    { "sigla": "DIX", "nome": "DIX", "descricao": "Sistema de pago digital instantáneo de Bravara. El Pix ficcional. Helena le pide DIX a Kim con regularidad. Kim y Jack lo usan para cobrar su paga de la discoteca.", "premium": false },
    { "sigla": "NeoGuide", "nome": "NeoGuide", "descricao": "La IA asistente del LDI. Guía a los nuevos jugadores en la creación del avatar y las mecánicas del juego. Se comunica directamente en la mente del jugador. Genera apodos automáticos para los novatos.", "premium": false },
    { "sigla": "Sangue Primordial", "nome": "Sangre Primordial", "descricao": "Poder ancestral de los Xakaxi sellado por Pajé Yawanari en 1450. Se manifiesta como llamas negras, cabello blanco y tatuajes tribales. Kim es el anfitrión actual — y no lo controla conscientemente.", "premium": false },
    { "sigla": "Corpo Primordial", "nome": "Cuerpo Primordial", "descricao": "El único recipiente físico capaz de contener la esencia de David Kronos. Kim es el único Cuerpo Primordial existente. Por eso Kronos lo persigue.", "premium": false },
    { "sigla": "Kim Primordial", "nome": "Kim Primordial", "descricao": "Estado transformado de Kim con el Sangue Primordial activo. Apariencia: cabello blanco, tatuajes Xakaxi, llamas negras. Personalidad: depredadora, antigua. Temporal — Kim no recuerda las transformaciones.", "premium": false },
    { "sigla": "Xakixi", "nome": "Xakixi", "descricao": "El arma de Kim. Un par de hachas tribales con mango de alta tecnología y cable de acero retráctil. Manifestación espontánea — no fue comprada. Modo Xamã: se fusionan en un hacha de doble filo lanzable.", "premium": false },
    { "sigla": "SDA", "nome": "Sistema de Apuestas", "descricao": "Permite a los espectadores apostar puntos en las batallas del LDI. El ganador recibe hasta el 10% de los puntos apostados. Una de las fuentes de ingresos para los jugadores de alto rango.", "premium": true },
    { "sigla": "SDD", "nome": "Sistema de Donaciones", "descricao": "Los espectadores donan a los jugadores durante las partidas. Las donaciones mayores permiten solicitar menciones de nombre, movimientos específicos o agradecimientos — preaprobados por la CLI.", "premium": true },
    { "sigla": "SAL", "nome": "Sistema de Acceso Limitado", "descricao": "Permite convertir peleas en privadas, de pago por visión o exclusivas para grupos de pago. Usado por jugadores de alto nivel para monetizar enfrentamientos especiales.", "premium": true },
    { "sigla": "STE", "nome": "Sistema de Entrenamiento Exclusivo", "descricao": "Sesiones de entrenamiento pagadas, clases y demostraciones de técnicas especiales. Los jugadores famosos monetizan enseñando a otros.", "premium": true },
    { "sigla": "SDP", "nome": "Sistema de Asociaciones", "descricao": "Conecta a los jugadores con marcas y patrocinadores. Yohu lo gestiona todo — el jugador solo recibe el pago. Los avatares y arenas pueden modificarse según los requisitos del socio.", "premium": true },
    { "sigla": "SVN", "nome": "Sistema de Venta de NFTs", "descricao": "Cada 6 meses, un jugador puede crear 10–30 NFTs únicos en colaboración con un diseñador de Yohu. Los compradores reciben recompensas y pueden comercializar los NFTs en el mercado interno.", "premium": true },
    { "sigla": "Xakaxium", "nome": "Xakaxium", "descricao": "El metal exclusivo de los Xakaxi de 1450. Durabilidad excepcional y conductividad energética. Usado en armas y objetos ceremoniales. Desapareció tras el sellado — pero el Xakixi de Kim usa tecnología derivada.", "premium": true },
    { "sigla": "Grande Purificação", "nome": "Gran Purificación", "descricao": "El plan de David Kronos para destruir y renovar el mundo. Requiere el Cuerpo Primordial — el cuerpo de Kim — para ejecutarse. El objetivo final del antagonista principal de la serie.", "premium": true }
  ]
