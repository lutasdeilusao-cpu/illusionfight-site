  "xakaxi": {
    "intro": "In 1450, the Xakaxi were an indigenous civilization centuries ahead of their time. Not primitive — advanced. Until a forbidden ritual changed everything.",
    "tecnologias": [
      { "nome": "Carbon Fiber", "descricao": "Ultra-resistant material used in weapons and construction. Exclusive to the tribe in that era." },
      { "nome": "Robotic Agriculture", "descricao": "Automated food production systems. The tribe did not depend on manual labor to survive." },
      { "nome": "Amplifier Glasses", "descricao": "Optical devices that enhanced vision for hunting, warfare, and precision craftsmanship." },
      { "nome": "Xakaxium Metal", "descricao": "Metal exclusive to the Xakaxi. Exceptional durability and energy conductivity. Used in weapons and ceremonial items. Vanished after the 1450 sealing." },
      { "nome": "Nexium Metal", "descricao": "Decorative metal used in Xakaxi adornments and jewelry. Nara, the matriarch, wore Nexium jewelry." },
      { "nome": "The Six Elements", "descricao": "Fire, Earth, Air, Water, Light, and Darkness — mastered by the Xakaxi as real spiritual powers. They became the foundation of LDI's elemental system, recreated by Yohualticit centuries later." }
    ]
  },
  "glossario": [
    { "sigla": "LDI", "nome": "Illusion Fight", "descricao": "The virtual arena created by Yohualticit in 2022. 100% real pain. Three billion players. The most-watched sport in the world by 20XX.", "premium": false },
    { "sigla": "SBI", "nome": "Illusion Battle Simulator", "descricao": "Hardware that connects the nervous system to the MDI. Composed of Immersor (body), Goggles (visual immersion), and Tech Glove (movement translation). Limited editions cost 60–70k units.", "premium": false },
    { "sigla": "MDI", "nome": "World of Illusions", "descricao": "The virtual dimension where LDI battles take place. Built by Yohualticit. Inside it, the laws of the real world are partially rewritten.", "premium": false },
    { "sigla": "MDR", "nome": "World of Reality", "descricao": "The physical real world — outside the SBI. This is where Kim sells candy, pays electricity bills, and lives with Helena.", "premium": false },
    { "sigla": "SDR", "nome": "Ranking Challenge System", "descricao": "LDI's global ranking system. Classifies every player in the world by performance. Determines income, visibility, and access to the World Tournament.", "premium": false },
    { "sigla": "PowWow", "nome": "PowWow", "descricao": "The dominant short-video social network of 20XX, dedicated to LDI. Kim vs. Thunderbolt went top 10 worldwide on the same day.", "premium": false },
    { "sigla": "DIX", "nome": "DIX", "descricao": "Bravara's instant digital payment system. The fictional Pix. Helena asks Kim for DIX regularly. Kim and Jack use it to receive their nightclub pay.", "premium": false },
    { "sigla": "NeoGuide", "nome": "NeoGuide", "descricao": "LDI's AI assistant. Guides new players through avatar creation and game mechanics. Communicates directly into the player's mind. Auto-generates nicknames for newcomers.", "premium": false },
    { "sigla": "Sangue Primordial", "nome": "Primordial Blood", "descricao": "Ancestral power of the Xakaxi sealed by Pajé Yawanari in 1450. Manifests as black flames, white hair, and tribal tattoos. Kim is the current host — and he doesn't control it consciously.", "premium": false },
    { "sigla": "Corpo Primordial", "nome": "Primordial Body", "descricao": "The only physical vessel capable of containing David Kronos's essence. Kim is the only Primordial Body in existence. That's why Kronos hunts him.", "premium": false },
    { "sigla": "Kim Primordial", "nome": "Kim Primordial", "descricao": "Kim's transformed state when Sangue Primordial is active. Appearance: white hair, Xakaxi tattoos, black flames. Personality: predatory, ancient. Temporary — Kim has no memory of the transformations.", "premium": false },
    { "sigla": "Xakixi", "nome": "Xakixi", "descricao": "Kim's weapon. A pair of tribal hatchets with high-tech handles and a retractable steel cable. Spontaneous manifestation — not purchased. Xamã Mode: merges into a throwable double-bladed axe.", "premium": false },
    { "sigla": "SDA", "nome": "Betting System", "descricao": "Allows spectators to wager points on LDI battles. The winner receives up to 10% of all points bet. One of the income sources for high-ranking players.", "premium": true },
    { "sigla": "SDD", "nome": "Donation System", "descricao": "Spectators donate to players during matches. Larger donations can request name mentions, specific moves, or shoutouts — pre-approved by the CLI.", "premium": true },
    { "sigla": "SAL", "nome": "Limited Access System", "descricao": "Allows fights to be made private, pay-per-view, or exclusive to paying groups. Used by high-level players to monetize special matchups.", "premium": true },
    { "sigla": "STE", "nome": "Exclusive Training System", "descricao": "Paid training sessions, classes, and demonstrations of special techniques. Famous players monetize by coaching others.", "premium": true },
    { "sigla": "SDP", "nome": "Partnership System", "descricao": "Connects players to brands and sponsors. Yohu handles everything — the player just receives payment. Avatars and arenas may be modified per partner requirements.", "premium": true },
    { "sigla": "SVN", "nome": "NFT Sales System", "descricao": "Every 6 months, a player can create 10–30 unique NFTs in partnership with a Yohu designer. Buyers receive rewards and can trade the NFTs on the internal market.", "premium": true },
    { "sigla": "Xakaxium", "nome": "Xakaxium", "descricao": "The Xakaxi's exclusive metal from 1450. Exceptional durability and energy conductivity. Used in weapons and ceremonial items. Vanished after the sealing — but Kim's Xakixi uses derived technology.", "premium": true },
    { "sigla": "Grande Purificação", "nome": "Great Purification", "descricao": "David Kronos's plan to destroy and renew the world. Requires the Primordial Body — Kim's body — to execute. The final objective of the series' main antagonist.", "premium": true }
  ]
}
