  "glossario": [
    { "sigla": "LDI", "nome": "Lutas de Ilusão", "descricao": "A arena virtual criada pela Yohualticit em 2022. Dor 100% real. Três bilhões de jogadores. O esporte mais assistido do mundo em 20XX.", "premium": false },
    { "sigla": "SBI", "nome": "Simulador de Batalhas de Ilusão", "descricao": "Hardware que conecta o sistema nervoso ao MDI. Composto por Immersor (corpo), Óculos (imersão visual) e Luva Tecnológica (movimentos). Edições limitadas custam 60–70 mil unidades.", "premium": false },
    { "sigla": "MDI", "nome": "Mundo de Ilusões", "descricao": "A dimensão virtual onde ocorrem as batalhas do LDI. Construída pela Yohualticit. Dentro dela, as leis do mundo real são parcialmente reescritas.", "premium": false },
    { "sigla": "MDR", "nome": "Mundo de Realidade", "descricao": "O mundo físico real — do lado de fora do SBI. É aqui que Kim vende bala, paga a conta de luz e vive com Helena.", "premium": false },
    { "sigla": "SDR", "nome": "Sistema de Desafios Ranqueamento", "descricao": "Ranking global do LDI. Classifica todos os jogadores do mundo por desempenho. Determina renda, visibilidade e acesso ao Torneio Mundial.", "premium": false },
    { "sigla": "PowWow", "nome": "PowWow", "descricao": "Rede social de vídeos curtos dedicada ao LDI. Plataforma dominante em 20XX. A luta de Kim vs. Thunderbolt foi top 10 mundial no mesmo dia.", "premium": false },
    { "sigla": "DIX", "nome": "DIX", "descricao": "Sistema de pagamento digital instantâneo de Bravara. O Pix ficcional. Helena pede DIX de Kim regularmente. Kim e Jack usam para receber pelo trabalho na boate.", "premium": false },
    { "sigla": "NeoGuide", "nome": "NeoGuide", "descricao": "IA assistente do LDI. Guia novos jogadores na criação de avatar e mecânicas. Comunica diretamente na mente do jogador. Cria nicknames automáticos para novatos.", "premium": false },
    { "sigla": "Sangue Primordial", "nome": "Sangue Primordial", "descricao": "Poder ancestral dos Xakaxi selado por Pajé Yawanari em 1450. Manifesta-se como chamas negras, cabelo branco e tatuagens tribais. Kim é o hospedeiro atual — e não controla o poder conscientemente.", "premium": false },
    { "sigla": "Corpo Primordial", "nome": "Corpo Primordial", "descricao": "O único recipiente físico capaz de conter a essência de David Kronos. Kim é o único Corpo Primordial existente. É por isso que Kronos o persegue.", "premium": false },
    { "sigla": "Kim Primordial", "nome": "Kim Primordial", "descricao": "Estado transformado de Kim com o Sangue Primordial ativo. Visual: cabelo branco, tatuagens Xakaxi, chamas negras. Personalidade: predatória, antiga. Temporário — Kim não lembra das transformações.", "premium": false },
    { "sigla": "Xakixi", "nome": "Xakixi", "descricao": "Arma de Kim. Par de machadinhas tribais com cabo de alta tecnologia e cabo de aço retrátil. Manifestação espontânea — não foi comprada. Modo Xamã: une as duas em machado duplo lançável.", "premium": false },
    { "sigla": "SDA", "nome": "Sistema de Apostas", "descricao": "Permite que espectadores apostem pontos nas batalhas do LDI. O vencedor recebe até 10% dos pontos apostados. Uma das fontes de renda dos jogadores de alto ranking.", "premium": true },
    { "sigla": "SDD", "nome": "Sistema de Doações", "descricao": "Espectadores doam para jogadores durante as partidas. Doações maiores permitem pedir citação de nome, movimento específico ou agradecimento — pré-aprovados pela CLI.", "premium": true },
    { "sigla": "SAL", "nome": "Sistema de Acesso Limitado", "descricao": "Permite tornar lutas privadas, pay-per-view ou exclusivas para grupos pagantes. Usado por jogadores de alto nível para monetizar confrontos especiais.", "premium": true },
    { "sigla": "STE", "nome": "Sistema de Treinamento Exclusivo", "descricao": "Sessões pagas de treinamento, aulas e demonstrações de técnicas especiais. Jogadores famosos monetizam ensinando outros.", "premium": true },
    { "sigla": "SDP", "nome": "Sistema de Parcerias", "descricao": "Conecta jogadores a marcas e patrocinadores. A Yohu gerencia tudo — o jogador só recebe o valor. Avatar e arenas podem ser modificados conforme exigência do parceiro.", "premium": true },
    { "sigla": "SVN", "nome": "Sistema de Venda de NFTs", "descricao": "A cada 6 meses, jogador pode criar 10–30 NFTs únicos em parceria com designer da Yohu. Compradores recebem recompensas e podem negociar os NFTs no mercado interno.", "premium": true },
    { "sigla": "Xakaxium", "nome": "Xakaxium", "descricao": "Metal exclusivo dos Xakaxi de 1450. Alta durabilidade e condutividade energética. Usado em armas e itens cerimoniais. Desapareceu após o selamento — mas o Xakixi de Kim é feito com tecnologia derivada.", "premium": true },
    { "sigla": "Grande Purificação", "nome": "Grande Purificação", "descricao": "O plano de David Kronos para destruir e renovar o mundo. Requer o Corpo Primordial — o corpo de Kim — para ser executado. O objetivo final do antagonista principal da série.", "premium": true }
  ]
