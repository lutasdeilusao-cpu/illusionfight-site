            "fala": [
              "El cielo rojo contra el mundo azul, ¿me entiendes? Piénsalo.",
              "El ciego vio lo que el sordo escuchó, compañero. Y nadie les creyó a ninguno.",
              "El tren que pasa no vuelve… pero las vías quedan, ¿me entiendes?",
              "El que corre mucho llega temprano al lugar equivocado.",
              "La hormiga no tiene jefe y el hormiguero no se cae. Piénsalo, compañero.",
              "El café se enfría. El respeto no.",
              "Tú piensas que estás subiendo la calle, pero es la calle la que te está bajando a ti.",
              "Nombre grande en boca chica no pesa nada, chico.",
              "Yo fui el zanjón y fui el puente. Hoy soy el cordón."
            ],
            "escolhas": {
              "ouvir": {
                "label": "Escucha y sigue"
              }
            }
          },
          "veio_cafe": {
            "nome": "El viejo de la entrada",
            "sub": "la nariz ya olió el café",
            "fala": [
              "Mm… ¿qué es ese olor? Hace mucho que nadie me trae un café de verdad…"
            ],
            "escolhas": {
              "dar_cafe": {
                "label": "Dale el café al viejo",
                "resultado": "Se lo toma de un trago. Parpadea. La mirada se aclara — y de golpe ya no hay ningún viejo grogui ahí. Se levanta despacio, se truena el cuello y te clava los ojos."
              }
            }
          },
          "folgado_1": {
            "nome": "El Perfora-Tripas (?)",
            "sub": "el creído que manda en la Bajada — eso dice él",
            "fala": [
              "Yo soy el Perfora-Tripas, el dueño de esto. Tú ni mereces mi tiempo.",
              "¡Sangría! Arréglame a este chico. Tengo cosas más importantes."
            ]
          },
          "folgado_2": {
            "nome": "El Perfora-Tripas (?)",
            "sub": "escapó al otro lado de las vías",
            "fala": [
              "¿Tú otra vez? No pierdo el tiempo con nadies.",
              "Hielo, ocúpate de él. Yo estoy ocupado siendo importante."
            ]
          },
          "folgado_3": {
            "nome": "El Perfora-Tripas (?)",
            "sub": "volvió abajo de las vías, transpirando",
            "fala": [
              "Mira, me estás empezando a sacar.",
              "¡Sobra! ¿Dónde está la Sobra? ¡Trae a los Restos, ya!"
            ]
          },
          "folgado_4": {
            "nome": "El Perfora-Tripas (?)",
            "sub": "llamó refuerzos grandes",
            "fala": [
              "Bueno, bueno. Eres terco. Pero contra el Pedazo Mayor no aguantas.",
              "Arréglalo, Pedazo. Yo voy… para allá. A arreglar una cosa."
            ]
          },
          "folgado_5": {
            "nome": "El Perfora-Tripas (?)",
            "sub": "el último matón que quedó",
            "fala": [
              "¡Nadie le gana al Nombre del Sombra! ¡Nadie!",
              "Si pasas por él… no, no vas a pasar."
            ]
          },
          "folgado_final": {
            "nome": "El Perfora-Tripas (?)",
            "sub": "sin matones, sin adónde correr",
            "fala": [
              "Bueno… bueno. Somos tú y yo ahora. ¡Soy el Perfora-Tripas! Creo… creo que sí.",
              "Ven, que soy bravo. Muy bravo. Bravísimo, en serio."
            ]
          },
          "dona_cida": {
            "nome": "Doña Cida",
            "sub": "la panadería que abre antes del sol",
            "fala": [
              "El Pavo pasó corriendo por acá, todo morado, diciendo que su nombre no es Perfora-Tripas para nada.",
              "El Perfora-Tripas de verdad es Don Bucho, chico. El viejo de la entrada. Está así hace rato… solo un café fuerte lo despierta."
            ],
            "escolhas": {
              "pega_cafe": {
                "label": "Lleva el café del viejo",
                "resultado": "Lo pasa por el colador de tela, lo mete en una botellita y te lo da. \"Llévalo caliente. Frío no lo despierta.\""
              }
            }
          },
          "rinha_trilho": {
            "nome": "Riña de las Vías",
            "sub": "pelea sin fin al lado de las vías",
            "fala": [
              "La ronda de la Bajada no para, ni cuando pasa el tren.",
              "Termina una, entra otro, sorteado. Puedes dejar la tropa acá — 1 pelea cada 5 minutos."
            ]
          },
          "caixa_trilho": {
            "nome": "Caja al lado de las vías",
            "sub": "se cayó de algún vagón",
            "linha": "Una caja abollada tirada en el balasto: unos pesos y un frasco de jarabe que nadie volvió a buscar."
          },
          "birosca": {
            "nome": "Boliche de Doña Lurdes",
            "sub": "caña, pan y tranquilidad",
            "intro": "Doña Lurdes acomoda a la tropa en el fondo, lejos del ruido del tren. Cuesta unos pesos y todos salen enteros."
          },
          "birosca_2": {
            "nome": "Pensión de las Vías",
            "sub": "cama del otro lado de las vías",
            "intro": "Un cuarto apretado con vista a los rieles. No es lindo, pero la tropa duerme y vuelve a la calle."
          },
          "taxa_fixa": {
            "nome": "Resto de Cuchillo",
            "sub": "cobra en nombre de los tres pedazos",
            "fala": [
