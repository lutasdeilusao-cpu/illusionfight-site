          "onde": "Viene con la Vena, en la Encrucijada."
        },
        "12": {
          "nome": "Jalar el Cable",
          "desc": "Abres paneles, cerraduras y puertas del sistema jalando el cabo suelto.",
          "onde": "Se aprende entrenando la Vena el Día 2, o en el refugio de Kaeda."
        },
        "13": {
          "nome": "Andar Sin Rastro",
          "desc": "Entras a un sistema y sales sin disparar alarmas ni dejar registro.",
          "onde": "Alguien la enseña el Día 3, o se puede entrenar en el refugio de Kaeda."
        },
        "21": {
          "nome": "Contar el Ritmo",
          "desc": "Tu cuerpo agarra el compás del que pega antes que tu cabeza.",
          "onde": "Viene con la Vena, en la Encrucijada."
        },
        "22": {
          "nome": "Caer Bien",
          "desc": "Sabes recibir: caes sin romperte y te levantas antes de lo que el otro espera.",
          "onde": "Se aprende entrenando la Vena el Día 2, o en el refugio de Kaeda."
        },
        "23": {
          "nome": "Leer el Golpe",
          "desc": "Ves nacer el puñetazo en el hombro, medio segundo antes de que salga.",
          "onde": "Alguien la enseña el Día 3, o se puede entrenar en el refugio de Kaeda."
        },
        "31": {
          "nome": "Fijarse",
          "desc": "Notas el detalle que todos están entrenados para no ver.",
          "onde": "Viene con la Vena, en la Encrucijada."
        },
        "32": {
          "nome": "Leer el Registro",
          "desc": "Lees quién entró, cuándo y por dónde, y encuentras lo que no cuadra.",
          "onde": "Se aprende entrenando la Vena el Día 2, o en el refugio de Kaeda."
        },
        "33": {
          "nome": "Seguir el Dinero",
          "desc": "La gente miente, el dinero solo se mueve. Vas a donde fue.",
          "onde": "Alguien la enseña el Día 3, o se puede entrenar en el refugio de Kaeda."
        },
        "41": {
          "nome": "Escuchar la Plaza",
          "desc": "Te quedas cerca, te ríes del chiste correcto y la gente habla sola.",
          "onde": "Viene con la Vena, en la Encrucijada."
        },
        "42": {
          "nome": "Aceitar la Mano",
          "desc": "Sabes cuánto cuesta cada boca y pagas el precio justo, ni un centavo más.",
          "onde": "Se aprende entrenando la Vena el Día 2, o en el refugio de Kaeda."
        },
        "43": {
          "nome": "Leer la Mentira",
          "desc": "Ves en cómo alguien agarra el celular que está escondiendo algo.",
