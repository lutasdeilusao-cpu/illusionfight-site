  "custos": {
    "title": "How this project exists",
    "intro": "Illusion Fight is an independent project. One person, 23 years of development, launching in 2026. No investor. No team. Just a developer who works a full-time job from 9 to 6, then spends nights and weekends building this. Holidays, late nights, every free hour — man, that's just how it goes.",
    "s1": {
      "title": "What it costs to keep this running",
      "sub": "Current infrastructure",
      "item1": "illusionfight.com domain",
      "item2": "Supabase — database, authentication, server functions",
      "item3": "Stripe — payment processing",
      "sub2": "What it'll cost as it grows",
      "body": "Right now costs are low because the user base is still small. When it scales — and it will — it'll need dedicated servers, more database capacity, more processing power. Every online feature has a real cost. Real-time multiplayer, progress saving, global ranking — all of it runs on infrastructure that charges per use."
    },
    "s2": {
      "title": "Why free accounts have limits",
      "body": "It's not punishment. It's math. If a thousand people play for free and nobody contributes, the project shuts down or the games go offline. The limits exist so the project can survive while still giving real access to people who can't pay. As the user base grows, if the number of supporters doesn't keep up, free account limits will need to be adjusted. That'll be communicated here in advance, no surprises."
    },
    "s3": {
      "title": "What your subscription funds",
      "item1": "Infrastructure for everyone — including people who don't pay",
      "item2": "Production of new WEB SHARD chapters",
      "item3": "New games and updates",
      "item4": "Time — the scarcest resource here"
    },
    "s4": {
      "title": "One thing worth saying",
      "body": "No money goes to ads. No data is sold. No banners. The product is the product.",
      "thanks": "If you use it, enjoy it, and can contribute — thank you. That keeps the lights on.",
      "free": "If you can't contribute right now — that's fine. Enjoy what's available."
    },
    "footer": "This page is updated when costs change.",
    "cta": "See plans"
  },
  "webShard": {
    "meta_title": "WEB SHARD: Vertical Web Comic and Manga in Composite Pages",
    "meta_desc": "WEB SHARD is the vertical web comic and manga format with composite pages, overlapping cutaways and diagonal cuts. Read Illusion Fight free.",
    "hero": {
      "kicker": "WEB SHARD",
      "title": "Vertical Web Comic / Manga",
      "subtitle": "Every page is a whole scene. Overlapping cutaways, diagonal cuts, and action that spills into the next frame.",
      "cta1": "Read Illusion Fight now",
      "cta2": "See how it works"
    },
    "s1": {
      "title": "What is WEB SHARD?",
      "body1": "WEB SHARD is a vertical web comic and manga format built for reading on a phone. Instead of a line of loose panels, every page is composed as a self-contained scene: large hero panels, smaller overlapping cutaways, and diagonal cuts that guide the eye.",
      "body2": "The name comes from \"shard\" — a broken splinter of glass. The tilted cutaways layered over the scene look like shards, and that's what gives the format its signature."
    },
    "s2": {
      "title": "How a WEB SHARD page works",
      "step1_title": "Composite pages.",
      "step1_body": "Every page has its own composition, built for the phone screen.",
      "step2_title": "Overlapping cutaways.",
      "step2_body": "Details like a closing fist, a glance, or a foot hitting the ground show up in small cutaways layered over the scene, without taking up a whole panel.",
      "step3_title": "Diagonal cuts.",
      "step3_body": "No straight dividers: the tilted cut gives speed and pulls the reader through the action.",
      "step4_title": "Action that spills over.",
      "step4_body": "An arm, a can, a finger crosses the cut and lands in the next scene.",
      "cta": "Start reading"
    },
    "s3": {
      "title": "More impact on every page",
      "item1_title": "Cinematic pacing.",
      "item1_body": "Every cutaway is a beat: the reader feels the timing of the scene, not just the sequence of panels.",
      "item2_title": "Clear reading on mobile.",
      "item2_body": "Large hero panels and small cutaways guide the eye without cluttering the screen.",
      "item3_title": "More emotion in the details.",
      "item3_body": "A hand, an eye, a drop of sweat gets its own spotlight without stopping the read.",
      "item4_title": "Comedy and action with timing.",
      "item4_body": "The format is built for deadpan jokes and brawls, and for letting the page breathe between them."
    },
    "s4": {
      "title": "For readers of web comics, manga and action comics",
      "body": "If you like web comics, manga, fighting comics, and action-comedy stories, WEB SHARD is a new way to read on your phone. It's a format open to comic and manga alike, with total freedom of style and color per title."
    },
    "s5": {
      "title": "Illusion Fight, the first WEB SHARD title",
      "body1": "Bravara, 2XXX. In the LDI, the pain is real and winning is everything. Kim, 17, sells candy on the bus and never cared about some rich-kid game. Until he lost a bet.",
      "body2": "Action, humor and friendship, in the first title of the Illusion Fight universe.",
      "cta": "Read chapter 1 free"
    },
    "faq": {
      "title": "Frequently asked questions",
      "q1": "What is WEB SHARD?",
      "a1": "It's a vertical web comic and manga format in composite pages, with overlapping cutaways and diagonal cuts.",
      "q2": "Is WEB SHARD the same as webtoon?",
      "a2": "No. The classic webtoon is a continuous scroll of loose panels. In WEB SHARD, every page is a self-contained composition, with hero panels and overlapping cutaways. WEB SHARD is our own term, coined by Illusion Fight — it's not an industry format or the name of any platform.",
      "q3": "Do I need an app to read it?",
      "a3": "No. You read it straight in your browser, on phone or computer.",
      "q4": "Is WEB SHARD manga or comic?",
      "a4": "Both. The format is open: each title picks its own style, whether manga, comic, or something else.",
      "q5": "Where can I read it?",
