    "duvidas": {
      "eyebrow": "ASK NEOGUIDE",
      "itens": {
        "o_que_e": {
          "p": "What is Illusion Fight?",
          "r": "An action universe created by Isaias Leal. It started as a book and grew into a webtoon, games and a soundtrack, all connected on the site. There are three universes: Illusion Fight, The Shadow World and Sea of Ashes."
        },
        "ano_todo": {
          "p": "How long is the area available?",
          "r": "All year. All of Season 1 stays unlocked for you, and the area keeps getting new chapters, art and content ideas. Come back whenever you want."
        },
        "hiato": {
          "p": "Will there be breaks between releases?",
          "r": "Yes. After every three months of releases there's a rest month. That month brings The Shadow World and Sea of Ashes, extra stories by the same author. So there's never a gap in content."
        },
        "gratis": {
          "p": "Is it free for my audience?",
          "r": "Yes. The games and most of the stories are free. There's an optional subscription that unlocks chapters earlier. You get that early access at no cost."
        },
        "posso_falar": {
          "p": "Can I say bad things about it?",
          "r": "Yes. Criticism is content. Nobody approves anything beforehand and there's no script."
        },
        "republicar": {
          "p": "What can't I do?",
          "r": "Repost full content: a whole chapter, a whole webtoon episode or the original files. Excerpts, screenshots and up to 3 pages per post are fine."
        },
        "prazo": {
          "p": "How long do I have access?",
          "r": "The time shows at the top of your table. It depends on your channel size, from 1 to 6 months. It can be renewed."
        },
        "idiomas": {
          "p": "What languages is it in?",
          "r": "English, Portuguese and Spanish. Switch the language in the site menu and all the content follows."
        },
        "lancamento": {
          "p": "When does it launch?",
          "r": "Season 1 launches November 15, 2026. Before that, the universe is in Steam Next Fest, October 19–26."
        },
        "steam": {
          "p": "What's on Steam?",
          "r": "The Season 1 page (app 1876210) and the free demo (app 5188520). Adding it to your wishlist helps the project a lot."
        },
        "contato": {
          "p": "How do I reach the author?",
          "r": "Write to lutasdeilusao@gmail.com. Interviews, questions, a request for specific art: just ask."
        }
      }
    },
