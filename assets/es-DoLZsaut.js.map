        "adv_sintonia_elemental": "Sintonía Elemental",
        "adv_sintonia_elemental_desc": "Tu conexión con el elemento es natural. Tus ataques de Poder cuestan 1 PM menos.",
        "adv_mestre_arma": "Maestro de Arma",
        "adv_mestre_arma_desc": "Con tu arma preferida, eres letal. +1 de daño con tu arma actual.",
        "adv_leitura_combate": "Lectura de Combate",
        "adv_leitura_combate_desc": "Anticipas los movimientos del enemigo. +1 en FD contra el primer ataque de cada turno.",
        "adv_regeneracao_rapida": "Regeneración Rápida",
        "adv_regeneracao_rapida_desc": "Tu cuerpo se recupera más rápido dentro del LDI. Recupera 1 PV por turno de combate.",
        "adv_foco_mental": "Enfoque Mental",
        "adv_foco_mental_desc": "Tu concentración es un arma. +1 en FA en modo Poder.",
        "dis_corpo_fragil": "Cuerpo Frágil",
        "dis_corpo_fragil_desc": "Tu cuerpo no se adapta bien al LDI. Tu PV máximo se reduce en 2.",
        "dis_medo_arena": "Miedo a la Arena",
        "dis_medo_arena_desc": "La arena te intimida. Sufres -1 en FA en el primer turno de cada combate.",
        "dis_impulsivo": "Impulsivo",
        "dis_impulsivo_desc": "Actúas antes de pensar. Toda huida en combate tiene posibilidad de fallar (tirada 1-3 en d6 falla).",
        "dis_sobrecarga_sensorial": "Sobrecarga Sensorial",
        "dis_sobrecarga_sensorial_desc": "El LDI sobrecarga tus sentidos. Pierdes 1 PM al inicio de cada combate.",
        "dis_desconfiado": "Desconfiado",
        "dis_desconfiado_desc": "Confías en pocos. Algunas elecciones de diálogo pueden no estar disponibles.",
        "dis_dreno_energetico": "Drenaje Energético",
        "dis_dreno_energetico_desc": "El sistema drena tu energía. Recuperas 1 PM menos por día.",
        "dis_ataduras_frageis": "Vendas Frágiles",
        "dis_ataduras_frageis_desc": "Tus equipos de cura son ineficientes. La cura recibida se reduce en 1.",
        "dis_marca_visivel": "Marca Visible",
        "dis_marca_visivel_desc": "Tienes una marca digital única que los enemigos reconocen. Algunos enemigos serán más agresivos.",
        "perk_pericia_katana": "Pericia: Katana",
