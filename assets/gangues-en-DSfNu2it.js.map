          "guerra": "War",
          "sangue": "Blood in it",
          "coroa": "The Crown"
        },
        "gangues": {
          "rato_pista": "Track Rats",
          "bonde_sinal": "Red-Light Crew",
          "cobranca_turco": "The Shakedown",
          "os_gato": "The Splice",
          "sombra_rubra": "Crimson Shadow",
          "sombra_fria": "Cold Shadow",
          "os_restos": "The Leftovers",
          "bonde_predio": "Tower Crew",
          "os_andar_de_cima": "Upstairs",
          "frente_escada": "Stairway Front",
          "os_fogueteiro": "The Firework Boys",
          "os_cinco": "The Five",
          "a_roda": "The Ring",
          "bonde_costura": "The Patchwork's crew"
        },
        "bosses": {
          "fumaca": {
            "nome": "Coal",
            "fala": "You quick, kid? I'm smoke. Blink and I'm already gone — and you eat it in the dark without even seeing where the hit came from."
          },
          "turco": {
            "nome": "The Collector",
            "fala": "All of Marélia owes me. Now {suaGangue} does too. Round here, whoever can't pay in cash pays in bone."
          },
          "espeto": {
            "nome": "Gut-Stabber",
            "fala": "Good coffee. Been a long time since I woke up like this. You beat my boys and sent Peacock running… Fine. Now come take the Lowside, if you can handle it."
          },
          "sala": {
            "nome": "Rust",
            "fala": "Climbed ten floors just to get dropped on the last one? Respect the effort. Changes nothing."
          },
          "zefa": {
            "nome": "The Beast",
            "fala": "I raised half the kids {suaGangue} beat to get up here. Sit down. Your punishment's gonna take a while."
          },
          "doutor": {
            "nome": "The Accountant",
            "fala": "Do the math, kid. You've got two fighters. I've got the whole Hilltop owing me favors. Now go home."
          },
          "costura": {
            "nome": "The Patchwork",
            "fala": "All of Marélia was mine once. Six blocks in hand, the Rooftop under my feet. But this thing won't stitch — not even I held it. Come up here and I'll show you the hard way."
          }
        },
        "territorios": {
          "pista": {
            "nome": "The Track",
            "desc": "The raw asphalt down below. Kids chasing chains, selling gum, eyes everywhere. Rato de Pista with no big dreams, Bonde do Sinal cashing in on information. Nobody heavy yet — but every flag holder walked here first. The Patchwork did. A kid named Alan will walk it too, somewhere else — his turn just hasn't come yet. Now it's your turn."
          },
          "feira": {
            "nome": "The Market",
            "desc": "The stalls, the vendors, the spliced power lines. No shooting here — just debt. The Collector writes it all down, and the Collector collects it all."
          },
          "baixada": {
            "nome": "The Lowside",
            "desc": "Across the train tracks. The Shadow's crew split three ways when he died. Crimson, Cold and the Leftovers bite each other before they bite you."
          },
          "vila": {
            "nome": "The Projects",
            "desc": "The blocks, the ten-floor towers, the unlit stairwell. The crew runs it bottom to top. To reach the owner you climb it all taking hits."
          },
          "morro": {
            "nome": "The Hill",
            "desc": "The hillside slum, the concrete stairway that changes shape with every new rooftop. The spots, the firework boys. Nobody comes down the Hill the same."
          },
          "alto": {
            "nome": "The Hilltop",
            "desc": "Past the steel door. The Five nearly became a council — pulled half the Hill into one hand before the Patchwork came, and before you."
          },
          "laje": {
            "nome": "The Rooftop",
            "desc": "The top. On one side, all of Marélia watching. On the other, the Patchwork — the only one who ever held six blocks at once. This is where you find out if seven can be held."
          }
        },
        "falas": {
          "ponto": "{territorio}. This spot belongs to {gangue}, pal. {suaGangue} doesn't walk through here for free."
        },
        "final": {
          "code": "THE CLIMB ENDS HERE",
          "titulo": "MARÉLIA WON'T STITCH",
          "paragrafos": [
            "{gangue} put the Patchwork down on the Rooftop. All of Marélia saw it.",
            "And then you understood what he already knew. Two weeks and the map was split again — blocks pulling one way, spots pulling another. Nobody holds this city. He didn't. You didn't.",
            "Years later a kid with weird hair would do what neither of you could. His name was Alan. But that's another story — and you're in it, right at the start."
          ]
        }
      },
      "modes": {
        "dif_titulo": "Pick your hustle",
        "dif_facil": "Easy",
        "dif_facil_sub": "taking it slow",
        "dif_facil_desc": "The crew comes in weak. But on easy you get to the 6th hood and stop — the last boss won't stoop to face a kid. Want the top? Bump it to Medium.",
        "dif_medio": "Medium",
        "dif_medio_sub": "for real ones",
        "dif_medio_desc": "The way it was designed. The crew comes at your level and Carvão will see you. For real ones.",
        "dif_dificil": "Hard",
        "dif_dificil_sub": "roots",
        "dif_dificil_desc": "The crew comes with almost everything you've got, and Carvão still brings backup. For those who don't cry.",
        "abrir": "CHOOSE GAME MODE",
