      "velocidade_auto": "Auto speed",
      "log_passiva": "🛡 {nome}'s passive: {talento} came into play.",
      "log_status": "😵 {alvo} is now {status}.",
      "log_cura": "💚 {nome} used {talento} on {alvo} (+{n} Grit).",
      "status": {
        "1": {
          "nome": "Dozing",
          "desc": "Half Pace — takes twice as long to get a turn."
        },
        "2": {
          "nome": "Bleeding",
          "desc": "Loses 1 Grit every turn. Never knocks out: stops at 1."
        },
        "3": {
          "nome": "Noodle Arm",
          "desc": "−2 Wallop: hits a lot weaker."
        },
        "4": {
          "nome": "Open Guard",
          "desc": "−2 Hide: takes more damage."
