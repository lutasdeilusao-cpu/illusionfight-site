            "serralheria": "Bigode's Metal Shop",
            "pensao_2": "The daughter's boarding house",
            "galeria": "Cats' Gallery",
            "mercadao": "The Wholesale Market"
          },
          "catraca": {
            "nome": "The Turnstile",
            "sub": "the Cats' toll at the entrance",
            "fala": [
              "Whoa, whoa. Market entry isn't free, pal.",
              "Pay the change or get through us."
            ]
          },
          "banca_turco": {
            "nome": "The Turk's Stall",
            "sub": "where the Market pays its dues",
            "fala": [
              "New crew in the Market... The Turk likes new people. New people still pay on time.",
              "Arrival fee: 20. Pay and you're cool. Don't, and the Collector comes to chat."
            ],
            "fala_devedor": [
              "Look who's here. You're in the ledger, huh? Owing the loan shark and still wanting a stall.",
              "Pay the arrival fee or the collectors find you before you find the exit."
            ],
            "escolhas": {
              "paga_taxa": {
                "label": "Pay the 20 fee",
                "resultado": "He writes your name down neatly. \"A payer. The Turk likes that. His collectors don't like anyone, though — they're right over there.\""
              },
              "nao_paga": {
                "label": "Pay nothing",
                "resultado": "He closes the ledger slowly. \"Noted. Go talk to the collectors, then.\""
              }
            }
          },
          "cobranca": {
            "nome": "The collection",
            "sub": "the Turk's collectors",
            "fala": [
              "We came for what's the Turk's.",
              "Everybody pays. You'll pay too — one way or another."
            ]
          },
          "quadro_luz": {
            "nome": "The breaker box",
            "sub": "the tap that feeds the Market",
            "intro": "The Cats pull power for the whole Market from this box. Retrace the wires without touching the live ones — one mistake and the crew gets shocked, and the noise brings the gang."
          },
          "beco_gato": {
            "nome": "Cats' Alley",
            "sub": "where the wiring gang hides",
            "fala": [
              "You messed with our box? Nobody touches our power.",
              "The Cats live in the dark, pal. Come learn how it feels."
            ]
          },
          "balanca": {
            "nome": "The rigged scale",
            "sub": "the Turk's weight always wins",
            "fala": [
              "I do the weighing here. And I weighed you: you owe.",
              "Every stall pays whatever weight I say."
            ]
          },
          "caderneta_viva": {
            "nome": "The Ledger",
            "sub": "remembers every cent",
            "fala": [
              "I know the name of every debtor in Marélia. Yours is right here.",
              "Debtors get beaten with interest."
            ]
          },
          "mao_turco": {
            "nome": "The Turk's Hand",
            "sub": "the arm that collects",
            "fala": [
              "The pirate radio talked about me, huh? Then you know who I am.",
              "I'm the hand the Turk uses to settle accounts."
            ]
          },
          "caixa_forte": {
            "nome": "The Strongbox",
            "sub": "the Market's safe has legs",
            "fala": [
              "Everything the Market pays goes through me.",
              "Want the cash? Come take it out of the safe."
            ]
          },
          "radio": {
            "nome": "Toninho the Radio Guy",
            "sub": "fixes anything that crackles",
            "fala": [
              "This radio picks up the Settling Scores frequency — the Turk's guys talk about everything on it.",
              "Only it's fried. Bring me 1 copper wire and 3 valves and I'll make it talk."
            ],
            "escolhas": {
              "consertar": {
                "label": "Hand over the copper and 3 valves",
                "resultado": "Toninho solders, blows, turns the knob... and the radio crackles out a voice: \"The Hand and the Strongbox are in the Market today.\" Now you know where they are."
              }
            }
          },
          "camelo": {
            "nome": "The Street Vendor",
            "sub": "a bit of everything, cheaper if you can talk"
          },
          "muamba": {
            "nome": "Sunday Contraband",
            "sub": "cross the Market without the Raid seeing",
            "intro": "Carry the goods from one end of the Market to the other. The Raid is patrolling and the clock is ticking — get spotted and you lose it all."
          },
          "favor_marmita": {
            "nome": "Regina's lunchbox",
            "sub": "a favor for Dona Regina",
            "intro": "Dona Regina asked: take her son's lunchbox to the other side of the Market without the Raid seizing it. Favor paid means credit's open again."
          },
          "favor_devedor": {
            "nome": "Red Ink",
            "sub": "has owed Dona Regina for months",
            "fala": [
              "What? Regina sent you? I'll pay next week, I swear.",
              "Next week, same as last week."
            ],
            "escolhas": {
              "convence": {
                "label": "Talk him into it",
                "resultado": "He scratches his head, sighs and pays Regina. \"Fine, fine. She always fed me anyway.\""
              },
              "aperta": {
                "label": "Lean on him",
                "resultado": "He backs off and calls his buddies. \"Came to collect with your fists? Then take some fists.\""
              }
            }
          },
          "favor_cobrador": {
            "nome": "The boarding house collector",
            "sub": "is pressuring Dona Regina",
            "fala": [
              "The old lady owes the Turk. Out of the way.",
              "Wanna pay for her? Pay in bruises."
            ]
          },
          "pagina_1": {
            "nome": "Torn page",
            "sub": "from the Turk's ledger",
            "linha": "Stuck to the floor of a stall: a page from the Turk's ledger, full of names and numbers. There are more around."
          },
          "pagina_2": {
            "nome": "Another page",
            "sub": "from the Turk's ledger",
            "linha": "On the dark side, folded in a crate: another ledger page. There's a note from the Collector in the margin."
          },
          "pagina_3": {
            "nome": "The last page",
            "sub": "from the Turk's ledger",
            "linha": "Hidden in the Cats' Gallery: the last page. Together they show where the Collector is weak — he drops his guard when he collects."
          },
          "radio_pirata": {
            "nome": "The pirate radio",
            "sub": "the Settling Scores frequency",
            "fala": [
              "The radio crackles in the corner of the shop. Between the static, a voice talks about the Lowside.",
              "\"...down there the Gut-Stabber runs things. Anyone who wants to reach him has to listen first...\""
            ],
            "escolhas": {
              "ouvir": {
                "label": "Listen to the whole frequency",
                "resultado": "You write down everything the radio said about the Lowside. When the time comes, you'll know the way in."
              }
            }
          },
          "pensao": {
            "nome": "Dona Regina's Boarding House",
            "sub": "hot food and a clean bed",
            "intro": "Dona Regina serves a plate of food and settles the crew in a corner. Costs a bit of cash — and if you're broke, she finds another way.",
            "favor_pedir": "Broke — ask for credit in exchange for a favor",
            "favor_pendente": "You still owe Regina a favor",
            "favor_fala": "\"Eat, kid. Later you do me a favor — the Market is full of people who owe me.\""
          },
          "pensao_2": {
            "nome": "The daughter's boarding house",
            "sub": "Regina's daughter, on the dark side",
            "intro": "Dona Regina's daughter runs a boarding house on the dark side, by candlelight. Same rule as her mom: pay a bit and the crew gets patched up.",
            "favor_pedir": "Broke — ask for credit in exchange for a favor",
            "favor_pendente": "You still owe Regina a favor",
            "favor_fala": "\"My mom told me about you. Eat up — settle the favor with her.\""
          },
          "juro_alto": {
            "nome": "High Interest",
            "sub": "lends big, collects way bigger",
            "fala": [
              "Need big money, kid? I don't do small change.",
              "300 in hand right now. But the bill... the bill is mine."
            ],
            "botao_ver_contrato": "I want the 300",
            "contrato_tag": "Contract · high interest",
            "contrato_corpo": "\"300 in hand, right now. Take it or leave it?\"",
            "contrato_letra_miuda": "Fine print: you'll owe {divida}.",
            "contrato_aceitar": "I accept",
            "contrato_recusar": "I refuse"
          },
          "deposito_1": {
            "nome": "The warehouse door",
            "sub": "High Interest and his goons",
            "fala": [
              "Past here is the Wholesale Market. Nobody passes without paying.",
              "And you can't afford what we charge."
            ]
          },
          "deposito_2": {
            "nome": "The Market guard",
            "sub": "only opens for people with a name",
            "fala": [
              "You got a name in the Market? Prove it.",
              "The Turk only sees people the street respects."
            ]
          },
          "rinha_apostas": {
            "nome": "The Market Pit",
            "sub": "endless brawls, one after another",
            "fala": [
              "Out here in the dark the ring never stops spinning.",
              "Step in and take the hits. This is where you grind, not where you get rich.",
              "The ring never stops: one's done, the next one steps in, drawn at random. You can leave the crew here — 1 brawl every 5 minutes."
            ]
          },
          "mercearia": {
            "nome": "Mr. Aziz's Grocery"
          },
          "serralheria": {
            "nome": "Bigode's Metal Shop",
            "fala": "Nando does the first tune-up. I go all the way: bring the piece and scrap and I'll have it hitting hard every time."
          },
          "galeria": {
            "m1": {
              "nome": "Cats' lookout",
              "fala": [
                "Came into the Gallery? This is the Cats' house, pal.",
                "Nobody crosses without paying the toll."
              ]
            },
            "porta": {
              "nome": "The Cats' door",
              "sub": "locked with their code",
              "intro": "An iron door with a code lock. The Cats change the password every week — crack the code to get through. Get it wrong and they'll come check who touched it."
            },
            "m2": {
              "nome": "The Cats in the middle",
              "fala": [
                "You opened our door? Now you're stuck in here with us.",
                "In the dark we see better than you."
              ]
            },
            "m3": {
              "nome": "Exit lookout",
              "fala": [
                "Almost out, huh? Almost.",
                "The light is on the other side of me."
              ]
            }
          },
          "mercadao": {
            "m2": {
              "nome": "Sledge",
              "fala": [
                "The cold room is for dead meat. You're staying here.",
                "I guard what's the Turk's. You don't pass."
              ]
            },
            "achado": {
              "nome": "The hidden stock",
              "sub": "what the Turk keeps for himself",
              "linha": "Behind the merchandise boxes: cash, scrap and a good piece. The Turk won't notice — he never counts his own stock."
            },
            "livro_caixa": {
              "nome": "The cash book",
              "sub": "the whole Market's accounts",
              "fala": [
                "On the desk, the Turk's cash book. Every stall, every debtor, every cent.",
                "On the last sheet, a note from the Collector: \"when I collect, I drop my guard\"."
              ],
              "escolhas": {
                "ler": {
                  "label": "Read it all",
                  "resultado": "You close the book. Gather the 3 ledger pages and the Collector steps into the fight with his guard down."
                }
              }
            },
            "barraca_1": {
              "nome": "The first stall owner",
              "fala": [
                "You took the wrong aisle into the Wholesale Market, pal. Every stall in here is the Turk's.",
                "Wanna pass? Pay the canvas toll — in bruises."
              ]
            },
            "barraca_2": {
              "nome": "The pastry crew",
              "fala": [
                "Hey, hey, hey! Call the boys, there's an intruder between the stalls!",
                "In here we fight as a pack, kid. Alone, you don't get out."
              ]
            },
            "barraca_3": {
              "nome": "The canvas lookout",
              "fala": [
                "This maze was built so nobody finds the safe.",
                "And whoever finds it gets beat by me first."
              ]
            },
            "barraca_4": {
              "nome": "The aisle inspector",
              "fala": [
                "Every stall you pass is a debt you make, you know?",
                "I'm collecting this one right now."
              ]
            },
            "barraca_5": {
              "nome": "The collectors' square",
              "fala": [
                "You made it far, huh. All the Turk's collectors in one place.",
                "From here on, only people who settle up get through."
              ]
            },
            "barraca_6": {
              "nome": "The last in the row",
              "fala": [
                "After me there's just Sledge and the safe.",
                "And you won't see either one."
              ]
            }
          }
        },
        "briga_auto": "Auto brawl",
        "briga_auto_aviso": {
          "titulo": "AUTO BRAWL // YOU BUMPED, NOW IT'S ON",
          "frases": [
            "Went looking for smoke? Well, you found it. Brace yourself!",
            "Rolled up talking tough? Now you gotta back it up.",
            "Uh-oh, bad luck: his crew's already closing in.",
            "No chickening out, homie — it's hands now.",
            "Bumped the wrong hardhead, kid. Go in heavy!",
            "Nowhere left to run. Throw down!",
            "Yikes… this one didn't come to talk. Gotta go in heavy.",
            "You went looking for trouble. Trouble looked back."
          ]
        },
        "baixada": {
          "informante_vila": {
            "nome": "Dona Lurdes",
            "sub": "the bar hears everything",
            "fala": [
              "You wanna go to the Projects? Kid, those are ten-floor towers, and every floor has an owner.",
              "My nephew lives on the fifth. Says Rust lives way up top, and nobody ever reached him without taking a beating on every flight."
            ],
            "escolhas": {
              "ouvir": {
                "label": "Hear everything about the Projects",
                "resultado": "She tells you about the front desk, the padlock, the unlit stairwell and Dona Neide on the fifth floor. When the time comes, you know who to look for."
              }
            }
          },
          "chegada": [
            "This is the Lowside, kid. The other side of the train tracks.",
            "When Shadow went into the ditch, his crew split in three: Sangria, Ice and Leftover. There's a loudmouth here who says he runs it all — calls himself Gut-Stabber and never stops running.",
            "Nobody respects you for free here. Every fight you win is respect in your account.",
            "And watch the train: when it whistles, get off the tracks."
          ],
          "aviso_informante": "Nobody in the Lowside will take you to the boss yet. The Market's pirate radio knows the way — listen to it first.",
          "checklist_dica": "Earn the Lowside's respect: beat the loudmouth until he's got nowhere left to run.",
          "checklist_passagem": "The old man woke up. Go to the entrance and face the real owner of the Lowside.",
          "hint_cafe_falta": "The loudmouth spilled it: the Lowside's owner is the old man at the entrance. Get a coffee at Dona Cida's bakery.",
          "hint_cafe_pronto": "Coffee in hand. Take it to the old man at the entrance.",
          "pich": "SHADOW LIVES",
          "grafite": "THE TRAIN\nDOESN'T WAIT",
          "trem_apito": "🚨 TRAIN COMING",
          "trem_atropelo": "The train brushed past — the crew took a hit and got thrown off the tracks.",
          "respeito_titulo": "RESPECT IN THE LOWSIDE",
          "respeito_falta": "{n} more before the loudmouth stops running",
          "respeito_cheio": "respect full — the loudmouth has nowhere left to run",
          "predio": {
            "birosca": "Dona Lurdes' Bar",
            "padaria": "Dona Cida's Bakery",
            "birosca_2": "Trackside Inn",
            "deposito": "Old Nono's Storeroom"
          },
          "int": {
            "birosca": "Dona Lurdes' Bar",
            "padaria": "Dona Cida's Bakery",
            "birosca_2": "Trackside Inn",
            "deposito": "Old Nono's Storeroom"
          },
          "veio": {
            "nome": "The old man at the entrance",
            "sub": "groggy, sitting on the curb",
            "fala": [
              "The red sky against the blue world, you feel me? Think about that.",
              "The blind man saw what the deaf man heard, partner. And nobody believed either of them.",
              "A train that passes doesn't come back… but the tracks stay, you feel me?",
              "Whoever runs too much gets to the wrong place early.",
              "Ants have no boss and the anthill never falls. Think about that, partner.",
              "Coffee gets cold. Respect doesn't.",
              "You think you're climbing the street, but the street's the one taking you down.",
              "A big name in a small mouth weighs nothing, kid.",
              "I've been the ditch and I've been the bridge. Today I'm the curb."
            ],
            "escolhas": {
              "ouvir": {
                "label": "Listen and move on"
              }
            }
          },
          "veio_cafe": {
            "nome": "The old man at the entrance",
            "sub": "his nose already caught the smell",
            "fala": [
              "Hm… what's that smell? Been a long time since anyone brought me a real coffee…"
            ],
            "escolhas": {
              "dar_cafe": {
                "label": "Hand the old man the coffee",
                "resultado": "He drinks it in one gulp. Blinks. His eyes clear — and suddenly there's no groggy old man there anymore. He stands up slowly, cracks his neck and stares you down."
              }
            }
          },
          "folgado_1": {
            "nome": "Gut-Stabber (?)",
            "sub": "the loudmouth who runs the Lowside — or so he says",
            "fala": [
              "I'm Gut-Stabber, I own this place. You're not even worth my time.",
              "Bloodletter! Handle this punk for me. I've got better things to do."
            ]
          },
          "folgado_2": {
            "nome": "Gut-Stabber (?)",
            "sub": "ran to the other side of the tracks",
            "fala": [
              "You again? I don't waste my time on nobodies.",
              "Ice, deal with him. I'm busy being important."
            ]
          },
          "folgado_3": {
            "nome": "Gut-Stabber (?)",
            "sub": "back below the tracks, sweating",
            "fala": [
              "Look, you're starting to get on my nerves.",
              "Leftover! Where's Leftover? Get the Scraps over here, now!"
            ]
          },
          "folgado_4": {
            "nome": "Gut-Stabber (?)",
            "sub": "called in big backup",
            "fala": [
              "Fine, fine. You're stubborn. But you won't handle the Biggest Shard.",
              "Take care of it, Shard. I'm gonna… go over there. Take care of something."
            ]
          },
          "folgado_5": {
            "nome": "Gut-Stabber (?)",
            "sub": "the last henchman left",
            "fala": [
              "Nobody beats Shadow's Name. Nobody!",
              "If you get past him… no, you're not getting past him."
            ]
          },
          "folgado_final": {
            "nome": "Gut-Stabber (?)",
            "sub": "no henchmen, nowhere to run",
            "fala": [
              "Okay… okay. It's you and me now. I'm Gut-Stabber! I… I think.",
              "Come on, I'm tough. Real tough. Super tough, honest."
            ]
          },
          "dona_cida": {
            "nome": "Dona Cida",
            "sub": "the bakery that opens before the sun",
            "fala": [
              "Peacock came running in here, all bruised, saying his name isn't Gut-Stabber at all.",
              "The real Gut-Stabber is Old Bucho, kid. The old man at the entrance. He's been like that a long time… only a strong coffee will wake him up."
            ],
            "escolhas": {
              "pega_cafe": {
                "label": "Take the old man's coffee",
                "resultado": "She pours it through the cloth filter, bottles it and hands it over. \"Take it hot. Cold won't wake him.\""
              }
            }
          },
          "rinha_trilho": {
            "nome": "Trackside Pit",
            "sub": "endless fights by the tracks",
            "fala": [
              "The Lowside's circle never stops, not even when the train goes by.",
              "One ends, another steps in, random. You can leave your crew here — 1 fight every 5 minutes."
            ]
          },
          "caixa_trilho": {
            "nome": "Crate by the tracks",
            "sub": "fell off some wagon",
            "linha": "A dented crate dumped on the gravel: some cash and a bottle of syrup nobody came back for."
          },
          "birosca": {
            "nome": "Dona Lurdes' Bar",
            "sub": "booze, bread and some peace",
            "intro": "Dona Lurdes sets the crew up in the back, away from the train noise. Costs a little and everyone walks out whole."
          },
          "birosca_2": {
            "nome": "Trackside Inn",
            "sub": "a bed on the other side of the tracks",
            "intro": "A cramped room overlooking the rails. Not pretty, but the crew sleeps and gets back to the grind."
          },
          "taxa_fixa": {
            "nome": "Knife Leftover",
            "sub": "collects for all three shards",
            "fala": [
              "Need cash? In the Lowside money's got three owners, and I collect for all three.",
              "500 in your hand now. The bill… I'll tell you the bill later."
            ],
            "botao_ver_contrato": "I want the 500",
            "contrato_tag": "Contract · three shards",
            "contrato_corpo": "\"500 in hand, right now. Take it or leave it?\"",
            "contrato_letra_miuda": "Fine print: you'll owe {divida}.",
            "contrato_aceitar": "Deal",
            "contrato_recusar": "No deal"
          },
          "deposito": {
            "nome": "Old Nono's Storeroom"
          }
        }
      },
      "enemy_album": {
        "1701": "Rides the stick-up bike. Never gets off, just revs — the backseat does the talking.",
        "1702": "Rides on the back and calls the stick-up. \"Nobody's safe.\"",
        "1711": "Works the late-night patrol. Frisks anyone still on the street after ten.",
        "1712": "Runs the patrol car. Doesn't want explanations, wants ID.",
        "1101": "Doesn't fight, he runs and warns — facing him is a chase before a beating.",
        "1102": "The corner's eye — clocks everything moving on the Track, and comments on all of it.",
        "1103": "The fastest on the Track — bolts after two hits in a row.",
        "1104": "One of the boldest Cats, taps even a watched pole.",
        "1105": "A debtor turned thug to pay off his own debt.",
        "1106": "Light stun shock — the Market's living alarm.",
        "1107": "The youngest of the shards, still proving himself.",
        "1108": "Attacks timed to the passing train.",
        "1109": "Spreads a rumor about a rival before the fight.",
        "1110": "Watches the main door, warns the whole crew.",
        "1111": "Patrols the dark stairwell, uses the light as a weapon.",
        "1112": "Fights over any small thing, always on edge.",
        "1113": "Hits from range before you get close.",
        "1114": "Fires two at once, unpredictable.",
        "1115": "Knows every hidden path on the Hill.",
        "1116": "Literal door guard, never leaves the post.",
        "1117": "Guards the Five's private room.",
        "1118": "Owes the Accountant, fights to pay it off.",
        "1119": "Last step before the sewing room — nothing passes unseen.",
        "1120": "Sees all that comes and goes on the Roof, reports straight to the Patchwork.",
        "1121": "Spots all of Marélia before any attack lands.",
        "1201": "Corner kids — the first real scrap.",
        "1202": "Copied Coal until the nickname stuck.",
        "1203": "Dirty fighter, fast hits, low damage.",
        "1204": "Runs illegal power hookups — vanishes among the stalls.",
        "1205": "Works the stall by day, collects by night.",
        "1206": "Collects an old debt only he remembers.",
        "1207": "Devotee of the dead Shadow, still \"talks to him\".",
        "1208": "Recycles weapons from junk — unpredictable damage.",
        "1209": "Lives near where the Shadow fell, the others avoid him.",
        "1210": "Strangles with a clothesline, improvised weapon.",
        "1211": "Access to every unit, valuable information.",
        "1212": "Undercover — looks like an ordinary resident.",
        "1213": "Uses the Hill's slope as a weapon.",
        "1214": "Makeshift builder, tool as weapon.",
        "1215": "One of the kids she raised, borrowed technique.",
        "1216": "Always fights in a pair, never alone.",
        "1217": "Punishes anyone who breaks the Wheel's formation.",
        "1218": "Recruits and trains for the Five.",
        "1219": "Freshly recruited, still proving himself to the crew.",
        "1220": "The only stash left up top — small, symbolic.",
        "1221": "Sells the sewing scraps — literal patchwork.",
        "1301": "Aggressive, a step above the common kids.",
        "1302": "Scars from those who lost to him — war trophies.",
        "1303": "Steals what he sees, won't let go of what he grabs.",
        "1304": "Street collector — hits before the boss really collects.",
        "1305": "Knows what every resident owes, uses it as a mind game.",
        "1306": "\"Weighs\" everything — people included, literally.",
        "1307": "Claims to be the rightful successor, no one agrees.",
        "1308": "The angriest of the Shadow's three shards.",
        "1309": "The calculating shard — doesn't miss.",
        "1310": "Runs the ground floor.",
        "1311": "Runs a whole floor.",
        "1312": "Only attacks in tight space, dirty hallway fighting.",
        "1313": "Stairway watch with say over who climbs.",
        "1314": "Captain — rose fast, hits harder than anyone.",
        "1315": "Guards the last bend before the Upper Hill.",
        "1316": "One of the five who nearly became a council.",
        "1317": "Right hand of the near-formed council.",
        "1318": "Fights in formation, protects the center.",
        "1319": "Front line of the Patchwork's crew.",
        "1320": "Second line, trusted with half the Roof.",
        "1321": "Oldest general, no wasted motion.",
        "1401": "A candy seller with a rock in his pocket.",
        "1402": "Collects to the last coin, never miscounts.",
        "1403": "Trusted muscle, collects big debts without talk.",
        "1404": "Doubles the debt if the deadline slips.",
        "1405": "The most desperate shard — nothing to lose.",
        "1406": "Collects for all three shards at once.",
        "1407": "Looks down on the crew from above.",
        "1408": "Collects the \"rent\" the crew imposes on every floor.",
        "1409": "Fires a warning, doesn't mind hitting you.",
        "1410": "Keeps the books on who owes Zefa a favor.",
        "1411": "The most ambitious of the Five.",
        "1412": "Works straight for the Accountant.",
        "1413": "Few attacks, but they land.",
        "1414": "Closes the account of anyone climbing without paying the toll.",
        "1451": "Commands every lookout — if he whistles, the block runs.",
        "1452": "The oldest of the Signal Crew, trained the kids.",
        "1453": "The Collector's right hand, handles what he won't touch.",
        "1454": "Guards the whole Market's money.",
        "1455": "The most respected shard, nearly reunited the Lowside alone.",
        "1456": "Uses the dead boss's name as a weapon.",
        "1457": "Runs a whole building by himself.",
        "1458": "Access to every unit — info worth more than cash.",
        "1459": "Minds the kids when Zefa can't.",
        "1460": "Controls the climb alone, no one passes without a nod.",
        "1461": "One of the Five closest to a real council seat.",
        "1462": "Leads the Wheel in battle — doctrine made flesh.",
        "1463": "General — runs the whole Roof for the Patchwork.",
        "1464": "Scissors' right hand, never misses the final cut.",
        "1500": "Vanishes mid-street, strikes in the dark. Boss of the Track.",
        "1501": "Logs everything, collects everything. Breaks an arm before the face.",
        "1502": "Took the whole Lowsides when the Shadow fell in the ditch.",
        "1503": "Lives on the tenth floor — you arrive already tired.",
        "1504": "Raised half the kids around here. Knows where to hit to hurt without harm.",
        "1505": "Doesn't fight out of anger — fights because the math works out.",
        "1600": "The only one who ever held six blocks at once.",
        "1322": "The loudmouth who called himself Gut-Stabber. A boss's swagger, an extra's punch."
      },
