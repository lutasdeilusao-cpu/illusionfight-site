          "fios": "jury-rigged wiring",
          "gato": "the Cats' code",
          "rapa": "the Raid is patrolling"
        },
        "feira": {
          "chegada": [
            "This is the Market, kid. No gunfire here — just bills.",
            "Every stall pays the Turk, and every cent is in his ledger. The upper half is pitch dark: the Cats cut the power.",
            "Want the Collector? Make the whole Market respect you first."
          ],
          "aviso_informante": "The Collector won't even see you yet. Someone back on the Track knows the way in — talk to Duda.",
          "boss_trancado": "The blackout barricade is shut — sort out the lower Market first.",
          "muro_passagem": "The barricade won't open — but the Cats' Gallery runs underneath.",
          "checklist_dica": "Clear everything down here to open the Cats' Gallery.",
          "checklist_passagem": "Gallery open — cross to the dark side.",
          "minimapa_galeria": "Cats' Gallery",
