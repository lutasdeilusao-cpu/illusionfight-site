        "agiota_socorro": "Beg {agiota} for help",
        "agiota_socorro_tag": "{agiota}'s out of patience",
        "agiota_socorro_fala": "{agiota} shakes his head. \"Enough, kid. That debt's past what I can even collect. I'll patch you up for free — but you're settling this in the pit, like it or not.\"",
        "agiota_socorro_seguir": "Go on (blindfold now)",
        "dominada": "TAKEN",
