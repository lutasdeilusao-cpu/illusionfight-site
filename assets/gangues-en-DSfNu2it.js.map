      "naming": {
        "titulo": "FOUND YOUR GANG",
        "titulo_editar": "RENAME THE GANG",
        "poster_pitch": "Every street knows a name. Choose the one all of Marélia learns to respect — or to fear.",
        "label": "Gang name",
        "placeholder": "e.g. End of the Line Crew",
        "fundar": "FOUND THE GANG",
        "salvar": "SAVE",
        "renomear": "rename",
        "abertura": [
          "So you're thinking about starting a gang, huh? Think you can hang with Marélia's heavy hitters?",
          "Careful what you wish for, kid. Up there are people who've swallowed whole flags for breakfast. The Patchwork once held six blocks in one hand — and you're here, out of nowhere, thinking it'll go different for you.",
          "Fine. Just don't go nameless. A street name becomes a legend or a joke — and it's the one they'll spit back in your face when you're on the Rooftop, face to face with the real deal. Choose wisely."
        ]
      },
      "dialogo": {
        "voz": "A voice from the block",
        "veio_nome": "Old Nego",
        "veio_sub": "the corner elder, owner of the bar",
        "pular": "skip dialogue",
        "proximo": "keep going",
        "fechar": "got it, boss"
      },
      "cena": {
        "laje": {
          "chegada": [
            "This is the Rooftop, kid. The top. On one side, all of Marélia. On the other, the Patchwork.",
            "He's the only one who ever held six hoods at once. He treats crime like a spreadsheet, and every hood is a thread stitched in his hand.",
            "You're gonna meet people you already took down up here. They climbed up for revenge — and now they hit at Rooftop level.",
            "And pay attention: as long as his threads stay stitched down below, he won't go down easy. Up there nobody helps you. Climb with what you brought."
          ],
          "aviso_informante": "Nobody on the Rooftop will take you to the Patchwork yet. There's a message for you at the Hilltop Bar — hear it first.",
          "checklist_dica": "Get through the stitched entrance, the sewing room, and climb to the top. And cut the Patchwork's threads in the hoods below — every one left makes him stronger.",
          "checklist_passagem": "The way is open. Climb to the top of the Rooftop and end this.",
          "pich": "PATCHWORK CREW",
          "grafite": "THIS SHIT\nDON'T STITCH",
          "predio": {
            "birosca": "Rooftop Bar",
            "oficina": "Crew Tailor Shop",
            "loja": "Rooftop Shop",
            "sala_costura": "The Sewing Room",
            "topo": "The Top of the Rooftop"
          },
          "int": {
            "birosca": "Rooftop Bar",
            "oficina": "Crew Tailor Shop",
            "loja": "Rooftop Shop",
            "sala_costura": "The Sewing Room",
            "topo": "The Top of the Rooftop"
          },
          "fase_1_nome": "PHASE 1 · THE STITCH",
          "fase_2_nome": "PHASE 2 · THE QUILT",
          "fase_3_nome": "PHASE 3 · THE PATCHWORK",
          "linhas_titulo": "THE PATCHWORK'S THREADS",
          "linhas_sobram": "{n} thread(s) still stitched: +{n} Wallop and Hide on him",
          "linhas_todas": "every thread cut",
          "ultima_guarda": {
            "nome": "Last Watch",
            "sub": "nothing gets past unseen",
            "fala": [
              "From here up it's the Rooftop. You came a long way to die at the door.",
              "The Patchwork already knows you came up. He knows everything."
            ]
          },
          "revanche_carvao": {
            "nome": "Coal — the rematch",
            "sub": "came up from the Track after you",
            "fala": [
              "Remember me? The whole Track laughed at me after that day.",
              "Now I'm on the Rooftop, punk. And up here I'm not alone."
            ]
          },
          "fiapo": {
            "nome": "Thread",
            "sub": "the crew's first line",
            "fala": [
              "First line. You're gonna have to cut three.",
              "A loose thread is the one that hurts the most."
            ]
          },
          "revanche_cobrador": {
            "nome": "The Collector — the rematch",
            "sub": "came to collect an old debt",
            "fala": [
              "You owe me one, kid. The whole Market watched you drop me.",
              "Today I came to collect with interest."
            ]
          },
          "agulha": {
            "nome": "Needle",
            "sub": "the second line, trusted with half the Rooftop",
            "fala": [
              "Thin, but it goes through any hide.",
              "The Patchwork gave me half the Rooftop to watch. You won't get an inch."
            ]
          },
          "revanche_fura_bucho": {
            "nome": "Gut-Stabber — the rematch",
            "sub": "fully awake this time",
            "fala": [
              "You caught me hungover in the Lowside. Today I'm sober.",
              "I already had my coffee. Now it's you."
            ]
          },
          "linha_reta": {
            "nome": "Straight Line",
            "sub": "the Patchwork's oldest general",
            "fala": [
              "No wasted movement. None.",
              "Get past me and you're in the sewing room. You won't."
            ]
          },
          "revanche_ferrugem": {
            "nome": "Rust — the rematch",
            "sub": "came down from the roof to wait for you",
            "fala": [
              "You climbed ten floors to drop me. Here it's just one step.",
              "I respect the effort. Changes nothing."
            ]
          },
          "revanche_zefa": {
            "nome": "The Beast — the rematch",
            "sub": "Zefa came to deliver the punishment",
            "fala": [
              "You beat my kids to get to me. Now you'll see the Rooftop.",
              "Sit down. Your punishment started down there and ends here."
            ]
          },
          "costura_fina": {
            "nome": "Fine Stitch",
            "sub": "few hits, every one on target",
            "fala": [
              "One stitch at a time. That's how the Patchwork holds the city.",
              "You're just another loose stitch."
            ]
          },
          "tesoura": {
            "nome": "Scissors",
            "sub": "runs the Rooftop in the Patchwork's name",
            "fala": [
              "I'm the one who cuts here. You're fabric.",
              "Six hoods went through this room. None came out whole."
            ]
          },
          "corte_certo": {
            "nome": "Clean Cut",
            "sub": "Scissors' right hand, never misses the final cut",
            "fala": [
              "Scissors opens. I close.",
              "The last cut is always mine."
            ]
          },
          "revanche_contador": {
            "nome": "The Accountant — the rematch",
            "sub": "no games this time",
            "fala": [
              "On the Hilltop I played with you. Here the math is serious.",
              "Do the math, kid: you're alone on the last step."
            ]
          },
          "fase_costura": {
            "nome": "The Patchwork · The Stitch",
            "sub": "him and his scissors",
            "fala": [
              "Six hoods in my hand, and you thought you'd climb without me seeing?",
              "Scissors, Clean Cut. Stitch this one to the floor."
            ]
          },
          "fase_colcha": {
            "nome": "The Patchwork · The Quilt",
            "sub": "he got up different",
            "fala": [
              "You tore the stitch. Now you'll see the whole quilt.",
              "Every thread of this crew is me. Come on."
            ]
          },
          "mirante": {
            "nome": "The lookout",
            "sub": "all of Marélia down below",
            "fala": [
              "From here you can see the Track. It looks small. You started there.",
              "The Market lights up first. Then the Lowside, across the train tracks.",
              "The Hill never goes dark. Not even when the power drops.",
              "Six hoods. Each with its owner, its rules, its price.",
              "They say one day there'll be a kid who holds all of it. It's not his turn yet."
            ],
            "escolhas": {
              "olhar": {
                "label": "Look and move on"
              }
            }
          },
          "rinha_laje_topo": {
            "nome": "Top Ring",
            "sub": "endless fights on the roof of Marélia",
            "fala": [
              "The highest ring in the city. Whoever falls from here falls far.",
              "One ends, another steps in, random. You can leave the crew here — 1 fight every 5 minutes."
            ]
          },
          "birosca_laje": {
            "nome": "Rooftop Bar",
            "sub": "the last drink before the top",
            "intro": "The last bar before the Patchwork. Up there nobody patches you up — make the most of it here. Costs a little."
          },
          "ponto_da_laje": {
            "nome": "Roof Spot",
            "sub": "the last selling spot on the top",
            "fala": [
              "Cash? Up here everything belongs to the Patchwork. Even credit.",
              "1500 in your hand now. The bill... the bill gets stitched to your name."
            ],
            "botao_ver_contrato": "I want the 1500",
            "contrato_tag": "Contract · stitched",
            "contrato_corpo": "\"1500 in hand, right now. Take it or leave it?\"",
            "contrato_letra_miuda": "Fine print: you end up owing {divida}.",
            "contrato_aceitar": "I'm in",
            "contrato_recusar": "No deal"
          },
          "loja_laje": {
            "nome": "Rooftop Shop",
            "sub": "what's left of the stitching"
          },
          "alfaiataria": {
            "nome": "Crew Tailor Shop",
            "fala": "We stitch even iron here. Bring the piece and some scrap and I'll get it right — up to +9."
          },
          "planilha": {
            "nome": "The Patchwork's spreadsheet",
            "sub": "six hoods as columns",
            "linha": "A printed spreadsheet: six columns, one hood each, everybody's name and number. At the bottom, in the Patchwork's handwriting: \"doesn't add up\". Behind it, a little cash and a bottle of syrup."
          },
          "linhas": {
            "linha_pista": {
              "nome": "The Patchwork's thread on the Track",
              "sub": "Loose Scrap, hiding in the back",
              "fala": [
                "The Patchwork holds the Track through me. I'm his thread down here.",
                "Cut it, if you can. Otherwise he gets stronger up there."
              ],
              "escolhas": {
                "cortar": {
                  "label": "Cut the thread (with your fists)",
                  "resultado": "\"So you're the one climbing the Rooftop? Come cut it, if you got the scissors for it.\""
                }
              }
            },
            "linha_feira": {
              "nome": "The Patchwork's thread at the Market",
              "sub": "Cut Thread, among High Interest's books",
              "fala": [
                "Every stall at the Market pays a thread to the Patchwork. I'm the spool.",
                "You cut one thread, he stitches two."
              ],
              "escolhas": {
                "cortar": {
                  "label": "Cut the thread (with your fists)",
                  "resultado": "\"So you're the one climbing the Rooftop? Come cut it, if you got the scissors for it.\""
                }
              }
            },
            "linha_baixada": {
              "nome": "The Patchwork's thread in the Lowside",
              "sub": "Fine Stitch, across the train tracks",
              "fala": [
                "The Shadow's three shards answer to him. Through my hand.",
                "Come cut it. The train doesn't wait and neither do I."
              ],
              "escolhas": {
                "cortar": {
                  "label": "Cut the thread (with your fists)",
                  "resultado": "\"So you're the one climbing the Rooftop? Come cut it, if you got the scissors for it.\""
                }
              }
            },
            "linha_vila": {
              "nome": "The Patchwork's thread in the Projects",
              "sub": "Closed Account, on the ground floor",
              "fala": [
                "The Tower Crew holds a grudge, but they pay. I collect.",
                "Cut this thread and Rust stops sending his share upstairs."
              ],
              "escolhas": {
                "cortar": {
                  "label": "Cut the thread (with your fists)",
                  "resultado": "\"So you're the one climbing the Rooftop? Come cut it, if you got the scissors for it.\""
                }
              }
            },
            "linha_morro": {
              "nome": "The Patchwork's thread on the Hill",
              "sub": "Thread, the one Zefa never accepted",
              "fala": [
                "Zefa never knelt. But the Hill pays anyway — through me.",
                "You negotiated the stairway. With me there's no deal."
              ],
              "escolhas": {
                "cortar": {
                  "label": "Cut the thread (with your fists)",
                  "resultado": "\"So you're the one climbing the Rooftop? Come cut it, if you got the scissors for it.\""
                }
              }
            },
            "linha_alto": {
              "nome": "The Patchwork's thread on the Hilltop",
              "sub": "Needle, in the Accountant's book",
              "fala": [
                "The Patchwork absorbed the Five. I'm the thread that stayed.",
                "Cut it. Or he waits for you up there with the whole Hilltop at his back."
              ],
              "escolhas": {
                "cortar": {
                  "label": "Cut the thread (with your fists)",
                  "resultado": "\"So you're the one climbing the Rooftop? Come cut it, if you got the scissors for it.\""
                }
              }
            }
          }
        },
        "alto": {
          "informante_laje": {
            "nome": "The message from the Rooftop",
            "sub": "a thread from the Patchwork's crew",
            "fala": [
              "The Patchwork says: whoever took down the Accountant can come up to the Rooftop.",
              "But he holds every hood below by a thread. As long as it stays stitched, he won't fall."
            ],
            "escolhas": {
              "ouvir": {
                "label": "Take the message",
                "resultado": "The thread disappears down the stairs. Now the Patchwork's threads show up in the bars' back rooms down below — and the Rooftop is open."
              }
            }
          },
          "chegada": [
            "This is the Hilltop, kid. Behind the steel door.",
            "Up here five guys almost became a council. They pulled half the Hill into one fist before the Patchwork showed up.",
            "And the whole Hilltop owes the Accountant a favor. He doesn't fight out of anger — he fights because that's how the numbers add up.",
            "Each of the Five you handle your way: buy out his debt or break him with your fists. Just remember the Accountant writes everything down."
          ],
          "aviso_informante": "Nobody on the Hilltop will take you to the Accountant yet. There's a message for you at the Foot of the Hill Bar — hear it first.",
          "checklist_dica": "Get past the steel door and deal with the Five — buy them out or beat them. Then the Ring, the room of the Five and the Accountant's office.",
          "checklist_passagem": "The book is closed. Walk into the office and face the Accountant.",
          "pich": "THE FIVE",
          "grafite": "THE NUMBERS\nALWAYS ADD UP",
          "predio": {
            "birosca": "Hilltop Bar",
            "oficina": "Hilltop Forge",
            "emporio": "Hilltop Emporium",
            "sala_cinco": "The Room of the Five",
            "escritorio": "The Accountant's Office"
          },
          "int": {
            "birosca": "Hilltop Bar",
            "oficina": "Hilltop Forge",
            "emporio": "Hilltop Emporium",
            "sala_cinco": "The Room of the Five",
            "escritorio": "The Accountant's Office"
          },
          "caderno": {
            "titulo": "THE ACCOUNTANT'S BOOK",
            "resumo": "{comprados} bought out · {batidos} beaten"
          },
          "porta_aco": {
            "nome": "The steel door",
            "sub": "the only way into the Hilltop",
            "fala": [
              "You're not getting through. I am the door.",
              "Whoever punches a steel door breaks his hand first."
            ]
          },
          "sala_fechada": {
            "nome": "The locked room",
            "sub": "the Five's guard",
            "fala": [
              "The Five are in a meeting. Nobody interrupts.",
              "Wanna talk to them? Get through me first."
            ]
          },
          "cinco_verme": {
            "nome": "Worm",
            "sub": "the first of the Five",
            "fala": [
              "I've owed the Accountant six hundred for three years. He collects in favors, every month.",
              "You wanna pass? Either pay my tab or move me out of the way."
            ],
            "escolhas": {
              "comprar": {
                "label": "Buy out his debt (600)",
                "resultado": "You count the cash in front of him. He crosses his own name out of the Accountant's book. \"Now I owe you.\""
              },
              "encarar": {
                "label": "Settle it with your fists",
                "resultado": "\"Then come on. But know this: whoever gets beat by you goes crying to the Accountant.\""
              }
            }
          },
          "cinco_presa": {
            "nome": "Fang",
            "sub": "right hand of the council that almost was",
            "fala": [
              "We were gonna run the whole Hill. The Patchwork got here first.",
              "Pay what I owe the Accountant and I'll step aside. Otherwise, come on."
            ],
            "escolhas": {
              "comprar": {
                "label": "Buy out his debt (650)",
                "resultado": "You count the cash in front of him. He crosses his own name out of the Accountant's book. \"Now I owe you.\""
              },
              "encarar": {
                "label": "Settle it with your fists",
                "resultado": "\"Then come on. But know this: whoever gets beat by you goes crying to the Accountant.\""
              }
            }
          },
          "cinco_engrenagem": {
            "nome": "Gear",
            "sub": "fights in formation, guards the center",
            "fala": [
              "The Five work like a machine. Pull one piece and the rest jams.",
              "Seven hundred and I take myself apart. Or you take me apart by hand."
            ],
            "escolhas": {
              "comprar": {
                "label": "Buy out his debt (700)",
                "resultado": "You count the cash in front of him. He crosses his own name out of the Accountant's book. \"Now I owe you.\""
              },
              "encarar": {
                "label": "Settle it with your fists",
                "resultado": "\"Then come on. But know this: whoever gets beat by you goes crying to the Accountant.\""
              }
            }
          },
          "cinco_quase": {
            "nome": "Near-Council",
            "sub": "the most ambitious of the Five",
            "fala": [
              "I was gonna be the council. I still will. But first I gotta get out of that book.",
              "Buy my debt and I'll owe you. That's worth more than a beating."
            ],
            "escolhas": {
              "comprar": {
                "label": "Buy out his debt (750)",
                "resultado": "You count the cash in front of him. He crosses his own name out of the Accountant's book. \"Now I owe you.\""
              },
              "encarar": {
                "label": "Settle it with your fists",
                "resultado": "\"Then come on. But know this: whoever gets beat by you goes crying to the Accountant.\""
              }
            }
          },
          "cinco_quarto": {
            "nome": "Fourth Name",
            "sub": "the closest to becoming a real council",
            "fala": [
              "We were one name short of being a council. Just one.",
              "Eight hundred. Or you find out why they call me general."
            ],
            "escolhas": {
              "comprar": {
                "label": "Buy out his debt (800)",
                "resultado": "You count the cash in front of him. He crosses his own name out of the Accountant's book. \"Now I owe you.\""
              },
              "encarar": {
                "label": "Settle it with your fists",
                "resultado": "\"Then come on. But know this: whoever gets beat by you goes crying to the Accountant.\""
              }
            }
          },
          "roda": {
            "nome": "The Ring",
            "sub": "the formation that trains for the Five",
            "fala": [
              "Nobody fights alone here. Not us, not you.",
              "Step into the circle. Whoever holds up walks out."
            ]
          },
          "formacao_completa": {
            "nome": "Full Formation",
            "sub": "the Ring's doctrine made flesh",
            "fala": [
              "The Five were the head. I'm the body.",
              "You want the Accountant? He's on the other side of my formation."
            ]
          },
          "favor_devido": {
            "nome": "Owed Favor",
            "sub": "owes the Accountant, fights to pay it off",
            "fala": [
              "Every guy I drop is one month off the book.",
              "You're worth three months, at least."
            ]
          },
          "rinha_alto": {
            "nome": "Hilltop Ring",
            "sub": "endless fights with a view of all of Marélia",
            "fala": [
              "The Hilltop ring has the best view in the city. And the worst hits.",
              "One ends, another steps in, random. You can leave the crew here — 1 fight every 5 minutes."
            ]
          },
          "birosca_alto": {
            "nome": "Hilltop Bar",
            "sub": "fake whiskey and torn leather chairs",
            "intro": "Up here even the bar thinks it's a council. But the crew rests the same. Costs a little."
          },
          "divida_do_alto": {
            "nome": "Upper Debt",
            "sub": "works straight for the Accountant",
            "fala": [
              "Need cash? The Accountant always has some. And always writes it down.",
              "1200 in your hand now. The math, the Accountant does."
            ],
            "botao_ver_contrato": "I want the 1200",
            "contrato_tag": "Contract · the Accountant's book",
            "contrato_corpo": "\"1200 in hand, right now. Take it or leave it?\"",
            "contrato_letra_miuda": "Fine print: you end up owing {divida}.",
            "contrato_aceitar": "I'm in",
            "contrato_recusar": "No deal"
          },
          "emporio": {
            "nome": "Hilltop Emporium",
            "sub": "the best stuff that makes it up the Hill"
          },
          "ferraria_alto": {
            "nome": "Hilltop Forge",
            "fala": "We forge the steel door here. Bring the piece and some scrap and I'll get it right — up to +8."
          },
          "mesa_dos_cinco": {
            "nome": "The table of the Five",
            "sub": "where they almost became a council",
            "linha": "Five chairs, one empty. In the drawer, a little cash and a bottle of syrup nobody had the nerve to take."
          },
          "jogo_porrinha": {
            "nome": "The Accountant · Hand Sticks",
            "fala": "\"Sit down, kid. Before the beating, we play. Everybody knows how to fight. Hardly anybody knows how to count.\"",
            "regra": "Each of you has 3 sticks. Hide 0 up to what you have and guess the total of both hands. Whoever guesses the total throws one stick away. First to run out wins.",
            "ganhou": "\"Hm. You count right.\" He pushes his chair back and points to the back door. \"Pool. Come on.\"",
            "perdeu": "\"See? The math always works out in my favor.\" He shuffles the sticks again. \"Another one? I've got all night.\""
          },
          "jogo_bilhar": {
            "nome": "The Accountant · Three-Ball Pool",
            "fala": "\"Three balls, six pockets. I did it in five shots. You get six. Fair, right?\"",
            "regra": "Drag your finger back from the cue ball to aim and set the power, then let go. Sink all 3 balls in 6 shots or fewer. A scratched cue ball goes back to its spot and costs the shot.",
            "ganhou": "He claps slowly. \"Nice. Now we're talking.\" He takes off his jacket and folds it on the table. \"Now we do it the way you like.\"",
            "perdeu": "\"Ran out of shots, kid.\" He racks the balls again. \"Chalk up and try another.\""
          }
        },
        "morro": {
          "informante_alto": {
            "nome": "The message from the Hilltop",
            "sub": "a kid from the Ring",
            "fala": [
              "The Accountant says: whoever took down Zefa can come up to the Hilltop.",
              "But up there everything has a price. And the Accountant knows everybody's price."
            ],
            "escolhas": {
              "ouvir": {
                "label": "Take the message",
                "resultado": "The kid disappears behind the steel door. Now the Hilltop knows you're coming."
              }
            }
          },
          "chegada": [
            "This is the Hill, kid. Nobody ever took this place. Not even the Patchwork.",
            "Zefa doesn't sell the Hill, she negotiates it. And the Firework Boys lock the stairway with three gates.",
            "Every gate has a price, and you don't pay it up here: you pay it down below, in the hoods you already got in your pocket.",
            "Go back to the Track, the Market and the Lowside and negotiate your way up. Up here, your word is what counts."
          ],
          "aviso_informante": "Nobody on the Hill will take you to Zefa yet. There's a message for you at the bar in the Projects — hear it first.",
          "checklist_dica": "Climb the stairway. Gate locked? The pass is in a hood down below — the Track, the Market and the Lowside, in the bar's back room.",
          "checklist_passagem": "The stairway is open. Walk into Zefa's den.",
          "pich": "STAIRWAY FRONT",
          "grafite": "THE HILL\nDON'T GET TAKEN",
          "predio": {
            "birosca": "Foot of the Hill Bar",
            "oficina": "Rooftop Metal Shop",
            "venda": "Hill Store",
            "creche": "Zefa's Daycare",
            "boca": "Zefa's Den"
          },
          "int": {
            "birosca": "Foot of the Hill Bar",
            "oficina": "Rooftop Metal Shop",
            "venda": "Hill Store",
            "creche": "Zefa's Daycare",
            "boca": "Zefa's Den"
          },
          "barreira": {
            "pista": "GATE LOCKED · the pass belongs to Hornet, back on the Track",
            "feira": "GATE LOCKED · the Firework Boys want radios — negotiate at the Market",
            "baixada": "GATE LOCKED · the daycare needs medicine — negotiate in the Lowside"
          },
          "escadaria": {
            "nome": "The stairway",
            "sub": "the only way up",
            "fala": [
              "From here up you need a pass. And you got none.",
              "Every step here has an owner, pal."
            ]
          },
          "cupim": {
            "nome": "Termite",
            "sub": "the stairway lookout",
            "fala": [
              "I eat the stairs from the inside. You'll fall before you notice.",
              "Whoever climbs without asking comes down rolling."
            ]
          },
          "laje_nova": {
            "nome": "New Slab",
            "sub": "the Hill grows every week",
            "fala": [
              "Yesterday this was an alley. Today it's a slab. Tomorrow it's your grave.",
              "Stairs move around here, and you don't know a single one."
            ]
          },
          "posto_rojao": {
            "nome": "The firework post",
            "sub": "the alarm for the whole Hill",
            "fala": [
              "One bang and the whole Hill knows you came up.",
              "Short fuse, even shorter patience."
            ]
          },
          "segunda_mae": {
            "nome": "Second Mother",
            "sub": "watches the kids when Zefa can't",
            "fala": [
              "I changed diapers for half this crew. You think I'm scared of you?",
              "Hit hard, and I'll hit back with love."
            ]
          },
          "escadaria_inteira": {
            "nome": "Whole Stairway",
            "sub": "nobody passes without his nod",
            "fala": [
              "You negotiated the gates down below. With me there's no deal.",
              "I am the stairway. Climb over me, if you can."
            ]
          },
          "ultima_escada": {
            "nome": "Last Stair",
            "sub": "the last step before the den",
            "fala": [
              "From here you see the whole Hill. And it sees you falling.",
              "One more step and you're in front of Zefa. You won't make it."
            ]
          },
          "conta_do_morro": {
            "nome": "Hill's Tab",
            "sub": "keeps track of who owes Zefa a favor",
            "fala": [
              "Your name's in the book. Everybody who climbs is.",
              "Zefa only sees people whose tab is paid up."
            ]
          },
          "morador": {
            "nome": "Resident at the foot of the Hill",
            "sub": "watched the Hill grow slab by slab",
            "fala": [
              "The Firework Boys lock the stairs in three spots. Iron gates, thick padlocks.",
              "Hornet on the Track charges a toll to anyone who wants to go up. He and Zefa go way back.",
              "The Firework Boys always have broken radios. Whoever finds valves at the Market wins them over.",
              "Zefa's daycare never has enough medicine. Whoever sends some from the Lowside, she won't forget.",
              "The Patchwork almost took everything. The Hill he never took. Zefa just sat down and talked.",
              "Nobody climbs here by taking beatings. Here you climb by making deals."
            ],
            "escolhas": {
              "ouvir": {
                "label": "Listen and move on"
              }
            }
          },
          "rinha_morro": {
            "nome": "Top Slab Ring",
            "sub": "endless fights with a view of the Hill",
            "fala": [
              "The Hill's ring is on the highest slab, with the whole hood watching.",
              "One ends, another steps in, random. You can leave the crew here — 1 fight every 5 minutes."
            ]
          },
          "birosca_morro": {
            "nome": "Foot of the Hill Bar",
            "sub": "booze, bread and gossip",
            "intro": "The owner sets the crew up in a corner and makes everybody eat. Costs a little and nobody leaves hungry."
          },
          "fiado_da_zefa": {
            "nome": "Hill's Tab",
            "sub": "Zefa's credit line",
            "fala": [
              "Need something, kid? On the Hill, money comes with a favor attached.",
              "1000 in your hand now. The favor... Zefa picks the favor later."
            ],
            "botao_ver_contrato": "I want the 1000",
            "contrato_tag": "Contract · Zefa's credit",
            "contrato_corpo": "\"1000 in hand, right now. Take it or leave it?\"",
            "contrato_letra_miuda": "Fine print: you end up owing {divida}.",
            "contrato_aceitar": "I'm in",
            "contrato_recusar": "No deal"
          },
          "venda": {
            "nome": "Hill Store",
            "sub": "whatever comes up the stairs, she sells"
          },
          "serralheria_morro": {
            "nome": "Rooftop Metal Shop",
            "fala": "We weld the Firework Boys' gates here. Bring the piece and some scrap and I'll get it right — up to +7."
          },
          "creche": {
            "nome": "Zefa's Daycare",
            "sub": "untouchable, even for rivals",
            "fala": [
              "Nobody fights in here. Not you, not them. It's the one rule Zefa never negotiated.",
              "Zefa raised half the Hill in this room. The same kids you beat on the stairs.",
              "She never forgives anyone who messes with kids. And she never forgets who helps."
            ],
            "escolhas": {
              "ouvir": {
                "label": "Listen and leave in peace"
              }
            }
          },
          "creche_achado": {
            "nome": "The donation box",
            "sub": "for whoever needs it",
            "linha": "In the donation box, somebody left a little cash and a bottle of syrup. The daycare lady says it's for you: \"whoever helps the daycare, the daycare helps.\""
          }
        },
        "aval": {
          "aval_morro_pista": {
            "nome": "The Hill toll",
            "sub": "Hornet knows Zefa",
            "fala": [
              "You wanna climb the Hill? Heh. Zefa owes me an old favor, and I owe her another.",
              "Six hundred in my hand and I'll have the first gate opened. It's not a loan, kid. It's a toll."
            ],
            "escolhas": {
              "pagar": {
                "label": "Pay the toll (600)",
                "resultado": "He pockets the cash, picks up the phone and says two words. \"Go on up. The first gate is open.\""
              }
            }
          },
          "aval_morro_feira": {
            "nome": "The Firework Boys' radios",
            "sub": "High Interest makes the connection",
            "fala": [
              "The Firework Boys up on the Hill have busted radios. No radio, and fireworks are useless.",
              "Get me three valves and I'll send them up, and they'll open the second gate. The street vendor has them."
            ],
            "escolhas": {
              "entregar": {
                "label": "Hand over the 3 valves",
                "resultado": "\"Deal. The radios will crackle again and the second gate will open for you.\""
              }
            }
          },
          "aval_morro_baixada": {
            "nome": "The daycare medicine",
            "sub": "Dona Lurdes knows the daycare lady",
            "fala": [
              "Zefa's daycare has been out of medicine for weeks. The lady called me crying.",
              "Get me two Bone Potions, the ones from the Projects, and I'll take them myself. Zefa opens the last gate for whoever helped her kids."
            ],
            "escolhas": {
              "entregar": {
                "label": "Hand over the 2 Bone Potions",
                "resultado": "She wraps the potions in a dish towel. \"Zefa's gonna know it was you. The third gate is open.\""
              }
            }
          }
        },
        "fundos_nome": "BACK ROOM",
        "andar": "FLOOR {n}",
        "andar_terreo": "LOBBY",
        "vila": {
          "informante_morro": {
            "nome": "The message from the Hill",
            "sub": "a kid from the Stairway Front",
            "fala": [
              "Zefa says: whoever took down Rust can climb the Hill. But on the Hill you don't climb by taking beatings.",
              "The stairway gates only open with a pass. And the passes are down below, in the hoods you already own."
            ],
            "escolhas": {
              "ouvir": {
                "label": "Take the message",
                "resultado": "The kid disappears down the stairs. Now the Hill knows you're coming — and so do the hoods below."
              }
            }
          },
          "chegada": [
            "This is the Projects, kid. Three blocks, ten floors each, and a stairwell with no lights.",
            "The war here runs bottom to top: the Tower Crew holds the ground floor and the stairs, and the Upstairs folks live way up high.",
            "The owner is Rust, on the rooftop. To reach him you climb floor by floor, taking hits on every landing.",
            "And watch out for the Front Desk: he runs ahead warning the crew. The more you lose, the readier they wait for you."
          ],
          "aviso_informante": "Nobody in the Projects will take you to the rooftop yet. Dona Lurdes, at the bar in the Lowside, knows the way — hear her out first.",
          "checklist_dica": "Climb Block A: beat whoever holds each floor, all the way to the rooftop.",
          "checklist_passagem": "All ten floors are clear. Go up to the rooftop and face Rust.",
          "hint_elevador": "Dona Neide, on the 5th floor, has the elevator key. With it you go up and down without redoing the stairs.",
          "pich": "TOWER CREW",
          "grafite": "WHO GOES UP\nDON'T COME DOWN",
          "predio": {
            "birosca": "Ground Floor Bar",
            "oficina": "Janitor's Workshop",
            "brecho": "The Super's Thrift Shop",
            "bloco_a": "Block A"
          },
          "int": {
            "birosca": "Ground Floor Bar",
            "oficina": "Janitor's Workshop",
            "brecho": "The Super's Thrift Shop",
            "bloco_a": "Block A"
          },
          "alerta": {
            "titulo": "TOWER ALERT",
            "sobe": "the crew is warned: +{n} on each of them",
            "calmo": "nobody's seen you yet"
          },
          "elevador": {
            "nome": "The elevator",
            "sub": "broken since forever",
            "fala": [
              "The car creaks, the light flickers. Smells like burnt oil and trouble.",
              "Sometimes it stops halfway. And whoever's waiting outside isn't there to help."
            ],
            "escolhas": {
              "terreo": {
                "label": "Down to the ground floor"
              },
              "andar_1": {
                "label": "Up to the 1st floor"
              },
              "andar_5": {
                "label": "Go to the 5th floor"
              },
              "andar_9": {
                "label": "Go to the 9th floor"
              }
            },
            "travou": "The elevator got stuck between floors! The doors get pried open — and the crew is right outside."
          },
          "guarita": {
            "nome": "The guardhouse",
            "sub": "the front gate of the Projects",
            "fala": [
              "Resident? No. Visitor? Nope. Then you ain't coming in.",
              "Here the crew decides who goes up. And the crew said no."
            ]
          },
          "portaria_fuga_1": {
            "nome": "Front Desk",
            "sub": "ran to Block A yelling into his radio",
            "fala": [
              "Come in, come in, someone's coming up! Someone's coming up!",
              "Hold this guy while I warn the folks upstairs!"
            ]
          },
          "cadeado": {
            "nome": "Padlock",
            "sub": "runs the ground floor",
            "fala": [
              "You wanna get through that gate? Only over my body.",
              "The key to Block A is in my pocket. Come and get it."
            ]
          },
          "andar_1": {
            "nome": "1st floor",
            "sub": "the unlit stairwell starts here",
            "fala": [
              "Down here in the dark, I'm the one who sees.",
              "You trip, you fall. You fall, you get beat."
            ]
          },
          "andar_2": {
            "nome": "2nd floor",
            "sub": "the dark keeps going",
            "fala": [
              "You can't even find the next step and you wanna fight?",
              "Every floor has an owner. This one's mine."
            ]
          },
          "trinco": {
            "nome": "Deadbolt",
            "sub": "runs a whole floor",
            "fala": [
              "Two floors up and you're already sweating. Eight to go.",
              "Nobody gets through here without opening the deadbolt. And the deadbolt is me."
            ]
          },
          "andar_4": {
            "nome": "Front Desk, again",
            "sub": "still yelling into his radio",
            "fala": [
              "You again?! Guys, he's on the fourth floor!",
              "I call it in, they bring the beating. That's how it works here."
            ]
          },
          "condominio": {
            "nome": "The Complex",
            "sub": "the building fee nobody pays",
            "fala": [
              "You're behind on your fees, visitor. The fine goes on your face.",
              "The janitor here works for us. Got it?"
            ]
          },
          "andar_6": {
            "nome": "Front Desk, cornered",
            "sub": "nowhere left to run",
            "fala": [
              "Okay, okay! But if you get past here, I'll never warn anybody again!",
              "This radio's all I got, kid. Don't break it..."
            ]
          },
          "bloco_inteiro": {
            "nome": "Whole Block",
            "sub": "the seventh-floor general",
            "fala": [
              "You climbed seven floors to find me? Feel the weight of the block.",
              "I'm the wall that keeps this building standing."
            ]
          },
          "goteira": {
            "nome": "The Leak",
            "sub": "the Upstairs start here",
            "fala": [
              "Drips slow, but never stops. Just like me.",
              "From here up it's another level, punk. We pay for our lights."
            ]
          },
          "chave_mestra": {
            "nome": "Grand Master Key",
            "sub": "opens every door — except yours",
            "fala": [
              "Every door in this building opens with my key. Except the rooftop.",
              "You came far. But far ain't the top."
            ]
          },
          "apto_801": {
            "nome": "Apartment 801",
            "sub": "the janitor posing as a tenant",
            "fala": [
              "I've lived here twenty years. Nobody ever knocked on my door like that.",
              "You weren't supposed to see my uniform under the bathrobe."
            ]
          },
          "vizinho": {
            "nome": "Loud Neighbor",
            "sub": "loud music and a louder mouth",
            "fala": [
              "Rust never comes down. They say he hasn't touched the ground floor in ten years.",
              "The elevator? Breaks every week. But the crew fixes it real quick when it's time for an ambush.",
              "The Upstairs pay for the lights in their stairwell. The one down here stays dark on purpose.",
              "Dona Neide on the fifth is the only one the crew respects. She raised half of them when they were kids.",
              "Front Desk is scared of everything. But his radio is what holds this building together.",
              "Whoever climbs here gets tired. And Rust is counting on that."
            ],
            "escolhas": {
              "ouvir": {
                "label": "Listen and move on"
              }
            }
          },
          "varal_patio": {
            "nome": "Courtyard clothesline",
            "sub": "laundry forgotten ages ago",
            "linha": "In the pocket of some pants left on the line: a little cash and a bottle of syrup."
          },
          "apto_302": {
            "nome": "Apartment 302",
            "sub": "kicked-in door, pitch black",
            "linha": "Feeling around in the dark, you find a bandage and some cash on the floor."
          },
          "apto_604": {
            "nome": "Apartment 604",
            "sub": "the door was left open",
            "linha": "On top of the fridge: a bottle of bone potion and a little cash."
          },
          "rinha_laje": {
            "nome": "Rooftop Ring",
            "sub": "endless fights up on the slab",
            "fala": [
              "The Projects' ring is up on the slab, with the whole building watching from the windows.",
              "One ends, another steps in, random. You can leave the crew here — 1 fight every 5 minutes."
            ]
          },
          "birosca_vila": {
            "nome": "Ground Floor Bar",
            "sub": "warm beer and plastic chairs",
            "intro": "The owner sets the crew up in a corner, away from the stairs. Costs a little and everyone walks out whole."
          },
          "dona_neide_descanso": {
            "nome": "Dona Neide's apartment",
            "sub": "couch, coffee and a lecture",
            "intro": "Dona Neide puts the crew on the couch, brews some coffee and scolds everybody. Costs a little — and nobody leaves without eating."
          },
          "dona_neide": {
            "nome": "Dona Neide",
            "sub": "the only one the crew respects",
            "fala": [
              "Made it to the fifth, huh? The whole building's talking about you.",
              "Here, the elevator key. My knees can't take these stairs anymore, and yours won't either."
            ],
            "escolhas": {
              "pega_chave": {
                "label": "Take the elevator key",
                "resultado": "She takes the key off her neck and hands it over. \"Careful, it gets stuck. And when it does, it's no accident.\""
              }
            }
          },
          "aluguel_vencido": {
            "nome": "Overdue Rent",
            "sub": "collects for the Upstairs",
            "fala": [
              "Need cash, visitor? In the Projects everything has rent. Even money.",
              "800 in your hand now. The due date... I decide the due date."
            ],
            "botao_ver_contrato": "I want the 800",
            "contrato_tag": "Contract · overdue rent",
            "contrato_corpo": "\"800 in hand, right now. Take it or leave it?\"",
            "contrato_letra_miuda": "Fine print: you end up owing {divida}.",
            "contrato_aceitar": "I'm in",
            "contrato_recusar": "No deal"
          },
          "brecho": {
            "nome": "The Super's Thrift Shop",
            "sub": "whatever the building left behind, she sells"
          },
          "oficina_zelador": {
            "nome": "Janitor's Workshop",
            "fala": "I even fix elevators here, kid. Bring the piece and some scrap and I'll get it right — up to +6."
          },
          "caixa_dagua": {
            "nome": "The water tank",
            "sub": "the rooftop valve",
            "intro": "The valve on Rust's water tank sits in a tangle of pipes. Find the way without opening the wrong one — one mistake and the crew gets shocked, and the noise brings the janitor."
          }
        },
        "boss_trancado": "Lock the spots down before you level up, kid.",
        "treta_nao": "Not now, chill",
        "treta_sim": "Let's scrap",
        "treta_sim_risco": "Going in anyway",
        "nivel_rec_ocultar": "don't warn me again in this hood",
        "nivel_rec_baixo": "Recommended: crew at level {rec}. With gear counted, yours averages {atual} — you'll get wrecked. Run some jobs, level up on easier scraps, then come back.",
        "aleatorio": {
          "moto": {
            "nome": "Two on a Bike",
            "onomatopeia": "VROOOM!",
            "aviso": [
              "Heads up, kid! Things just got hot.",
              "Word is two guys on a bike are cruising the block, shaking everybody down.",
              "Nobody's safe out here — not even us. If they find you, there's no talking."
            ]
          },
          "policia": {
            "nome": "The Patrol",
            "onomatopeia": "FREEZE!",
            "aviso": [
              "The heat's on, kid! Cops in the area.",
              "A patrol car's sweeping the Track for whoever's making noise.",
              "Run if you want, but they know these streets better than you."
            ]
          },
          "bonde": {
            "nome": "Rival Crew",
            "onomatopeia": "BANG!",
            "aviso": [
              "Bad news, kid. Your name got around.",
              "A crew from another block crossed the line just to settle things with you.",
              "Three of 'em. And they didn't come to talk."
            ]
          },
          "cobranca": {
            "nome": "The Collector",
            "onomatopeia": "WHAM!",
            "aviso": [
              "Oh, kid... today's the day.",
              "The Bank's Collector is on the Track. Every crew pays its cut, and you owe yours.",
              "He doesn't take excuses. He takes cash or blood."
            ]
          },
          "rapa": {
            "nome": "The Raid",
            "onomatopeia": "TWEET!",
            "aviso": [
              "Heads up — city inspectors.",
              "They're sweeping the Market. Get caught and they take whatever's in your bag."
            ]
          },
          "apagao": {
            "nome": "Cats in the dark",
            "onomatopeia": "HSSS!",
            "aviso": [
              "Everything just went black...",
              "The Cats don't need light — they close in from every side."
            ]
          },
          "cobranca_divida": {
            "nome": "The Turk's Collection",
            "onomatopeia": "KNOCK KNOCK!",
            "aviso": [
              "The whole Market knows you owe.",
              "The Turk's collectors came for a cut. Lose, and they take some of your cash."
            ]
          }
        },
        "fechar": "Close",
        "parada_pular": "Leave it alone",
        "parada_tentar": "Take it on",
        "parada_ok": "Nice. The street opened up for the crew.",
        "parada_falha": "That went bad — and it woke folks up. Fight's coming.",
        "parada_falha_leve": "Didn't stick this time. Next time, kid.",
        "corre_ok": "Run done, no drama. Nato pays what was agreed, end of story.",
        "corre_falha": "The patrol car clocked you. Drop the package and bounce, now!",
        "tipo": {
          "treta": "Scrap",
          "parada": "Tricky run",
          "papo": "Word",
          "corre": "Run",
          "achado": "Find",
          "descanso": "Bar",
          "loja": "Shop",
          "agiota": "Loan shark",
          "banca": "Bets",
          "ferreiro": "Metal shop"
        },
        "descanso_titulo": "The crew rested. Each one recovered:",
        "descanso_ja_inteira": "The crew's already whole, kid. Keep the cash.",
        "descanso_sem_grana": "Cash is short for a rest, kid.",
        "descanso_curar": "Rest (−{grana})",
        "descanso_curar_caidos": "Revive the fallen (−{grana})",
        "descanso_animando": "Resting...",
        "tropa_no_chao": "Your whole crew's down, kid. Nobody's facing anyone like this. Hit Nato's corner store first.",
        "aviso_rep_treta": "That one's a whole different animal, kid. Don't go acting hard with no name made yet — stack up more rep before you step in there (rep {rep}).",
        "aviso_rep_clube": "{agiota} won't even let you in the circle without a name on the street. Build more rep before you show up here (rep {rep}).",
        "rep_recompensa": {
          "titulo": "REPUTATION {valor}!",
          "sub": "Your name's ringing out on the street, kid. Go on, grab it.",
          "pegar": "GRAB IT"
        },
        "emprestimo_pedir": "Take a loan (+{valor}, ends up owing {divida})",
        "emprestimo_contrato_tag": "Contract · no deadline",
        "emprestimo_contrato": "{agiota} counts {valor} into your hand, doesn't even count it twice. \"This one pays off, kid. Now you owe me {divida}. No deadline — just don't disappear.\"",
        "emprestimo_ja_deve": "You already owe {agiota}, kid. Settle that before asking for more.",
        "fiado_pedir": "Ask for more credit (heal everyone, ends up owing {divida})",
        "fiado_contrato_tag": "Contract · no deadline",
        "fiado_contrato_cura": "{agiota} has your whole crew healed, on the tab. \"Your debt doubled, kid. It's {divida} now.\"",
        "fiado_sem_emprestimo": "You don't owe anything yet, kid. Take {agiota}'s loan first.",
        "fiado_teto": "Your debt's maxed out, kid. {agiota}'s only fix now is throwing you into the pit.",
        "fiado_devendo": "{agiota}'s book: you owe {divida} cash.",
        "fiado_pagar": "Pay {agiota} (−{grana})",
        "fiado_pago_parcial": "Knocked {pago} off. Still {restante} left for {agiota}.",
        "fiado_pago_total": "Cleared the {pago}. Your name's clean with {agiota}.",
        "aviso_divida_chefe": "{chefe} won't face you while you owe {agiota}, kid. Clear that {divida} debt first — his pit's the fastest way.",
        "clube_botao": "▸ The Fight Club",
        "clube_oferta_tag": "Offer · {agiota}'s pit",
        "clube_oferta_limpo": "{agiota} looks you over. \"You're clean with me. But I got a job: betting pit, mine. You go in, you win, you walk with {premio} in hand. No experience — nobody learns anything in the pit. You lose, we patch you up and you try again. Only the buy-in's on credit: I heal you now and it turns into debt if you don't win. Deal?\"",
        "clube_oferta_divida": "{agiota} taps the book. \"You owe me. But I got a job for that: betting pit, mine. You go in, you win, your debt's gone — all of it, no matter the size. And you walk out with {premio} cash. No experience though — nobody learns a thing in the pit. You lose, we patch you up and you try again. The buy-in I float you — fifteen times — and I heal the whole crew. Deal?\"",
        "clube_recusar": "Not now",
        "clube_aceitar": "Take it (blindfold now)",
        "pista": {
          "chegada": [
            "This is the Pista, kid. The asphalt down below — the root of it all.",
            "Everybody worth something today crawled on this ground first. The Patchwork started here. A kid named Alan is going to start the same way, somewhere else — his turn just hasn't come yet. Now it's your turn to prove you're not just another face.",
            "Take the kids' spots, get your name running mouth to mouth. When the whole Pista knows you exist, Coal comes down out of the dark to face you — and that's when you find out if you've got what it takes.",
            "Move. Touch whatever's lighting up."
          ],
          "sinal": {
            "nome": "The stoplight corner",
            "sub": "kid selling candy, sharp eyes on everything",
            "fala": [
              "Hey, you with the new gang? Came down to the Pista alone, no crew behind you. Either you're brave or you're stupid — I'll know real soon.",
              "We don't just sell candy here, man. We sell what we see from this light. And we see EVERYTHING that moves on this block. Want to know something? Trade a word — or trade some cash."
            ],
            "escolhas": {
              "compra": {
                "label": "Buy the candy and hear what he saw",
                "resultado": "He closes his fist on the change without even counting it. \"The junkyard right up ahead. Old padlock, easy to crack. Inside there's scrap worth real money — and whatever the owner left before he vanished off the Pista for good.\""
              },
              "aperta": {
                "label": "Lean on the kid so he talks for free",
                "resultado": [
                  "The kid backs off but doesn't run. \"Ugh, now it's really gone bad. Should've bought the candy.\"",
                  "\"You lean on a kid like that and then want respect? Not happening.\" He whistles — and he's not alone."
                ]
              },
              "ignora": {
                "label": "Ignore him and keep climbing",
                "resultado": "You walk past without even a glance. The kid spits and burns your face into memory — information's a currency too, and now he owes you one. There's a junkyard up ahead."
              }
            }
          },
          "ferro": {
            "nome": "The junkyard",
            "sub": "locked gate, a secret kept inside",
            "intro": "The gate's just a chain with a combination lock — nothing a trained hand can't handle. The crew watches the pins turn once, then it's memorize the sequence and repeat it without a shake. Slip a hand and the guard wakes up and the game turns into a fight on the spot."
          },
          "beco": {
            "nome": "Rasteira's alley",
            "sub": "a Rato de Pista spot",
            "fala": [
              "This alley's Rato de Pista, pal. We don't want to climb, don't want your turf, don't want to own anything — we just don't want to get stepped on. And a fresh gang coming down here thinking it owns the street... this one gets stepped on, no tears.",
              "Well, look who's here. Fresh little crew thinking the Pista's a playground.",
              "This face again? Maybe this time you learn."
            ]
          },
          "rinha": {
            "nome": "The back-alley pit",
            "sub": "endless fights — even with the app closed",
            "fala": "Betting ring at the back of the alley, kid. You step in, you eat it or you cash out. There's always some nutcase wanting to test their hand against the fresh gang — come on, take it as many times as you can stay standing. The ring never stops here: one's done, the next steps in — weaker, stronger, luck of the draw. You can leave the crew here and go live your life: 1 brawl every 5 minutes."
          },
          "birosca": {
            "nome": "Old Nato's bar",
            "sub": "the corner elder — the only grown-up on the Pista you can trust",
            "fala": [
              "Sit, kid. Have some mate. You're climbing way too fast for someone nobody around here knows by name.",
              "I know where Coal hides when he vanishes into the dark. I'll tell you, no runaround. But first do me a run — take a package across without the patrol car's beam catching your trail.",
              "Handle that and the Pista starts to respect you, not just fear you. And the bar keeps its door open for your crew to rest whenever it needs to."
            ],
            "escolhas": {
              "aceita_corre": {
                "label": "Take Nato's run",
                "resultado": "\"Done, kid. Package is behind the counter. And a bonus: Rasteira's other spot is right up to the right.\""
              },
              "so_papo": {
                "label": "Just want the information",
                "resultado": "\"Stubborn, huh. Then straight to the bone: Rasteira's other spot is up there. Lock both down and Coal shows up on his own, wanting to know who you are.\""
              }
            }
          },
          "informante": {
            "nome": "Duda, the Ear",
            "sub": "knows everything that moves in Marélia before it's a rumor",
            "fala": [
              "Hey, back on the Pista? That's what this block is: everything that happens in Marélia passes through here before it's even corner gossip. And I hear ALL of it, kid.",
              "There's something going on over at the Feira the folks there won't tell you for free. The Collector's lying low, waiting for the right moment to show."
            ],
            "escolhas": {
              "perguntar": {
                "label": "Ask about the Feira",
                "resultado": "\"The Collector only comes out of hiding once he knows his enforcers already took a beating. Go to the Feira, handle the spots — then come back if you need more intel.\""
              }
            }
          },
          "corre": {
            "nome": "Nato's run",
            "sub": "carry the package without the patrol car seeing",
            "intro": "Cross the block with the package without stepping into the patrol car's beam — one wrong turn and it's a sure fight with a badge. The crew spreads out and covers your move. It's the price of Nato's information, and also the price of peace here on the Pista."
          },
          "beco_2": {
            "nome": "Rasteira's other spot",
            "fala": "You again? Took the alley down there and already figured the whole Pista would kneel for the fresh gang. Changes hands every week here, man — but not for whoever shows up thinking they own a corner on day one."
          },
          "descanso": {
            "nome": "Rest at the bar",
            "sub": "mate, bread and quiet",
            "intro": "Some time sitting, out of the hot street sun, in Nato's bar. Costs a little change, but it patches the crew up and everyone comes back whole — hurt, nobody wins a fight."
          },
          "descanso_2": {
            "nome": "The cousin's corner bar",
            "sub": "on the other side of the wall",
            "intro": "Nato's cousin runs a makeshift bar over on this side. Same deal: pay a little change and the crew sorts itself out before heading into Carvão's warehouse."
          },
          "agiota": {
            "nome": "Hornet",
            "sub": "lends fast, collects even faster",
            "fala": [
              "Psst. Need quick cash, kid? I lend 100. That's it — don't push for more.",
              "100 in your hand, right now. We settle up later — just don't come with excuses."
            ],
            "botao_ver_contrato": "I want the loan",
            "contrato_tag": "Contract · no deadline",
            "contrato_corpo": "\"100 in your hand, right now. You in or out?\"",
            "contrato_letra_miuda": "Fine print of the deal: you end up owing {divida}.",
            "contrato_aceitar": "I'm in",
            "contrato_recusar": "I'm out"
          },
          "posmuro_1": {
            "nome": "The watchdogs",
            "fala": [
              "\"You lost your mind coming here, huh?\" Carvão's first crew blocks the way.",
              "Two heavy dealers smoking on the warehouse steps. They spot you and spit on the ground."
            ]
          },
          "posmuro_2": {
            "nome": "The block manager",
            "fala": [
              "Carvão's right hand in person, with an escort. \"Past the wall, you come in by invitation. Were you invited?\"",
              "This one doesn't run. Folds his arms, signals the goons: \"handle it.\""
            ]
          },
          "loja": {
            "nome": "Pista Shop"
          },
          "loja_pocoes": {
            "nome": "Zé's Corner Shop"
          },
          "achado": {
            "nome": "The back of the junkyard",
            "sub": "what the owner left behind",
            "linha": "Behind a pile of scrap, a forgotten crate: some change and iron that still works. Nobody will miss it — the owner's long gone, vanished off the Pista, and nobody asks why."
          },
          "rasteira_velha": {
            "nome": "Old Rasteira",
            "sub": "the alley's owner in person",
            "fala": [
              "You beat the kids and already figured the Pista was yours? I trained every one of these punks with my own hands. Face me first — then Coal comes down to see you up close.",
              "Trained every one of these kids with these hands. Come see what's left to teach you.",
              "Back? Good. Now I get to teach it again, with more feeling."
            ]
          },
          "oficina": {
            "nome": "Nando's workshop",
            "sub": "Mr. Nando fixes what the street breaks",
            "fala": [
              "Look at the fresh little gang already working the spots. Let me tell you something, kid: to face Coal you need iron in your hand, not just chest.",
              "Bring me two pieces of scrap from that junkyard — one you pull cracking the lock, the other's hidden in the back. Bring them and I'll forge you a piece on the spot for your crew.",
              "And as a bonus I'll drop where Coal hides when he vanishes into the dark. That's worth more than any weapon, kid. We got a deal?"
            ],
            "escolhas": {
              "forjar": {
                "label": "Hand over the scrap and take the piece",
                "resultado": "Nando hammers a while, blows off the smoke and passes you a still-warm tin knuckle. \"Coal parks deep in Rasteira's alley, behind the wall. Vanishes in the dark, but always to the same corner — a crook always repeats a pattern. Now go up and get him.\""
              }
            }
          },
          "beco_3": {
            "nome": "The third spot",
            "sub": "another piece of Rato de Pista",
            "fala": "You people don't quit, huh? The Pista's got spots like bullet holes — there's always one more hidden in some corner. This one's mine. Come prove you're worth it, or go back where you came from."
          },
          "sinaleiro": {
            "nome": "The Head Signalman",
            "sub": "if he whistles, the whole block runs",
            "fala": [
              "I run the eyes of the whole Pista, kid. Every lookout, every signal, every runner at the light answers to my whistle. You got past all of them without anyone whistling — but you don't get past me. With me it's different.",
              "I whistle, the whole block runs to help. Who do you whistle to?",
              "Thought it'd be easy the second time? Wrong, kid."
            ]
          },
          "predio": {
            "bar": "Zé's Bar",
            "banca": "Shut-down stand",
            "mercado": "Cida's Corner Store",
            "fliperama": "Kiko's Arcade",
            "oficina": "Nando's Workshop",
            "lojapista": "Pista Shop",
            "tunel_ent": "Shack at the end of the alley",
            "tunel_sai": "Shack on the other side of the wall",
            "birosca_2": "The cousin's bar"
          },
          "grafite": "THE STREET\nREMEMBERS",
          "int": {
            "birosca": "Nato's Bar",
            "oficina": "Nando's Workshop",
            "loja": "Cida's Corner Store",
            "galpao": "Coal's Warehouse",
            "tunel": "The gap under the wall",
            "birosca_2": "The cousin's bar"
          },
          "galpao": {
            "m1": {
              "nome": "Vapor on lookout",
              "fala": [
                "Look at the fresh gang's kids trying to walk into the warehouse like it's nothing. No playboys who think they own the place in here, kid. This is the real thing.",
                "No playboys in here, kid. This is bone."
              ]
            },
            "m2": {
              "nome": "Mad Dog",
              "fala": [
                "Past the dock? Lucky I was sleeping light. Wake up now, 'cause the fight already started.",
                "Dozed off a second and look what's left to beat on.",
                "This time I was waiting, see. Come on."
              ]
            },
            "achado": {
              "nome": "Stockroom shelf",
              "sub": "what the operation keeps",
              "linha": "Back of the shelf, under some old rags: something useful. Nobody's going to notice it's gone."
            },
            "contador": {
              "nome": "The operation's bookkeeper",
              "sub": "keeps every tally, takes a beating for anyone",
              "fala": [
                "Don't hit me, kid! I just do the math, I swear to God! I'll talk, I'll talk, all of it...",
                "Coal stays in the dark, way in the back of it all. He only comes down once the whole warehouse knows you're here. And guess what — it knows."
              ],
              "escolhas": {
                "escuta": {
                  "label": "Hear him out",
                  "resultado": "\"That board back there is the operation schedule, for real. Coal crosses the last room every dawn, same time always. Good luck, kid — you'll need it.\""
                },
                "aperta": {
                  "label": "Rough the poor guy up (−rep)"
                }
              }
            }
          },
          "tunel": {
            "m1": {
              "nome": "Mouth lookout",
              "fala": [
                "Nobody goes down this hole without going through me first, kid. Back to your side while you still can.",
                "This hole's mine, kid. Nobody passes for free.",
                "Still trying this gap? You really are stubborn."
              ]
            },
            "m2": {
              "nome": "Tunnel tracker",
              "fala": [
                "You really think you're the first to try digging under? The ones who tried before are still down here in the dark, no way out.",
                "This hole's mine, kid. Nobody passes for free.",
                "Still trying this gap? You really are stubborn."
              ]
            },
            "m3": {
              "nome": "Exit lookout",
              "fala": [
                "Made it to the other side, huh? Only over me, kid. And I don't go down easy.",
                "This hole's mine, kid. Nobody passes for free.",
                "Still trying this gap? You really are stubborn."
              ]
            },
            "achado": {
              "nome": "Hole in the tunnel wall",
              "sub": "what someone stashed here",
              "linha": "Jammed into a crack in the dirt wall, half hidden: something that still works for the crew."
            }
          },
          "banca": {
            "nome": "Uncle Dice's Book",
            "fala": "\"Nobody gets beat up here, kid. Here you bet. Sharp head wins, sharp hands win — and whoever knows fighting reads the pit before the first punch.\""
          },
          "bancada_nando": {
            "nome": "Nando's workbench",
            "sub": "upgrades your gear",
            "fala": "Bring the piece and some scrap and I'll hammer it right. A weapon that hit soft now and then hits solid every time after I'm done."
          },
          "pich": "PISTA RATS"
        },
