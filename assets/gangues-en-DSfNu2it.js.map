      "clube": {
        "nome": "Fight Club",
        "saguao_tag": "Holding cage",
        "roda": "The pit",
        "sequestro_1": "You never saw where it came from. A cloth over your head, a hard yank, the ground gone from under your feet.",
        "sequestro_2": "Back of a van. Oil, cigarettes, the hot exhaust pipe against your back. A hand holding your neck down the whole way.",
        "sequestro_3": "They stop. They drag you out. They rip the cloth off in one pull — and the light blinds you. Wire mesh on both sides. And a roar of people that won't stop growing.",
        "venda_seguir": "tap to continue ›",
        "venda_entrar": "tap to enter the pit ›",
        "dica_anda": "Walk to the pit door.",
        "dica_porta": "This is it. Tap ENTER.",
        "entrar": "ENTER THE PIT",
        "interagir": "INTERACT",
        "result_code": "Fight Club · settling up",
        "sala_ronda": "Round {n} of 3 · clean",
        "sala_titulo": "YOU HELD",
        "sala_nato_1": "\"Where do you think you're going, kid? That was just to see if you're worth anything. Now it starts.\"",
        "sala_nato_2": "\"Two down. The next ones come in threes, together, and they're not here to test you — they're here to end you. Breathe.\"",
        "sala_tropa_ferida": "Your crew: {n} in trouble",
        "sala_tropa_ok": "Your crew's whole",
        "sala_caderneta": "Nato's book: you owe {divida}",
        "sala_entrar": "Go in as you are",
        "sala_ajeitar": "Let Nato fix you up",
        "sala_ajeitar_aviso": "heals everything — and the debt DOUBLES to your face: {antes} → {depois}",
        "sala_vazar": "Bail out",
        "sala_vazar_aviso": "walk out of the pit carrying the {divida} debt",
        "fuga_titulo": "YOU BAILED",
        "sequestro": [
          "You never saw where it came from.",
          "A thick cloth over your head. A yank that lifts you off your feet.",
          "Back of a van. Oil, cigarettes, the hot exhaust against your back. A hand pinning your neck down the whole way.",
          "They brake. They drag you out by the collar.",
          "They rip the cloth off in one pull — and the light burns your eyes. Wire mesh on both sides. And a roar of people that won't stop growing."
        ],
        "venceu_blocos": [
          "Last one standing is you. The whole pit saw it.",
          "Nato walks in hard, takes the book and tears it page by page in your face.",
          "«You're clean with me. Get lost.»",
          "Then he counts {premio} into your hand. They blindfold you again. You wake up on some corner of the Track — body aching, name back to zero."
        ],
        "venceu_blocos_grana": [
          "Last one standing is you.",
          "Nato counts {premio} into your hand. Dry, without looking at you.",
          "«Business is business.»",
          "You got nothing else — nobody leaves the pit smarter, just more marked up. They blindfold you, dump you on the Track with a heavy pocket."
        ],
        "perdeu_blocos": [
          "The pit floor came up fast.",
          "You wake up later: mattress on the ground, taste of blood, somebody closing your brow with sewing thread.",
          "Nato doesn't even show. He sends word through the muscle.",
          "«The buy-in is debt. And the pit never closes.»"
        ],
        "fuga_blocos": [
          "Jumped the wire mesh before the next one and slipped into the street.",
          "Nobody chased you. No need.",
          "Nato's book is yours now, fat as it got.",
          "«It finds you. At any bar. In any hood.»"
        ],
        "venceu_titulo": "YOU WALKED OUT WHOLE",
        "perdeu_titulo": "THEY PATCHED YOU UP",
        "voltar": "Back to the Track",
