    }
  ],
  "timeline": [
    {
      "ano": "1450",
      "titulo": "Apogeo Xakaxi",
      "texto": "La tribu Xakaxi en su cúspide: fibra de carbono, agricultura robótica, el metal Xakaxium, seis elementos dominados. Luego Powa — el hijo del chamán — realiza un ritual prohibido. Pajé Yawanari sacrifica su propio cuerpo para sellar el poder sagrado. La memoria tecnológica de la tribu es borrada."
    },
    {
      "ano": "1500",
      "titulo": "Invasión Feudal",
      "texto": "Invasores feudales llegan a Bravara. Los Xakaxi, sin protección espiritual ni memoria tecnológica, son conquistados. Yawanari observa impotente como espíritu guardián."
    },
    {
      "ano": "1637",
      "titulo": "Masacre Colonial",
      "texto": "Los conquistadores masacran y esclavizan a las poblaciones nativas de Bravara. Yawanari presencia cada muerte, atrapado en el plano espiritual."
    },
    {
      "ano": "1789",
      "titulo": "Revuelta de Durkria",
      "texto": "Rebelión en Bravara — seguida de ejecuciones públicas masivas. Más sangre para el espíritu que no puede intervenir."
    },
    {
      "ano": "1905",
      "titulo": "Primera Guerra Global",
      "texto": "El primer conflicto de escala mundial. Yawanari observa a la humanidad destruirse por primera vez a escala industrial."
    },
    {
      "ano": "1939",
      "titulo": "Segunda Guerra Global",
      "texto": "Campos de concentración. Bombas. Destrucción sistemática. El espíritu guardián ve la crueldad humana alcanzar nuevas cotas."
    },
    {
      "ano": "2001",
      "titulo": "Ataques Globales",
      "texto": "Torres derribadas. La relación del mundo con la seguridad y la paranoia cambia para siempre. Yawanari ya no entiende a la especie que juró custodiar."
    },
    {
      "ano": "2020",
      "titulo": "El Gran Vacío",
      "texto": "Pandemia global que reconfigura la sociedad. Aislamiento, muertes masivas, colapso económico. El mundo que emerge es diferente — más digital, más desigual."
    },
    {
      "ano": "2022",
      "titulo": "Nace el LDI",
      "texto": "Yohualticit crea el LDI. En un año, supera a todas las consolas lanzadas hasta entonces. Tres mil millones de personas. Dolor real. Rankings globales. Nace un nuevo deporte."
    },
    {
      "ano": "2024",
      "titulo": "La Era del PowWow",
      "texto": "Las plataformas de video corto llegan y dominan el mundo. PowWow explota. Yawanari, condenado a observar a la humanidad, descubre los videos de 15 segundos. Finalmente enloquece del todo."
    },
    {
      "ano": "20XX",
      "titulo": "La Historia Comienza",
      "texto": "Kim tiene 17 años, vende dulces en autobuses y estudia en Elite Academy con una beca del 50%. Una apuesta con Thunderbolt lo lanza al LDI. El Sangue Primordial despierta. David Kronos lo nota. Nada vuelve a ser igual."
    }
  ],
