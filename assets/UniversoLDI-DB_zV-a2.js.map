  "xakaxi": {
    "intro": "In 1450, the Xakaxi were an indigenous civilization centuries ahead of their time. Not primitive — advanced. Until a forbidden ritual changed everything.",
    "tecnologias": [
      {
        "nome": "Carbon Fiber",
        "descricao": "Ultra-resistant material used in weapons and construction. Exclusive to the tribe in that era."
      },
      {
        "nome": "Robotic Agriculture",
        "descricao": "Automated food production systems. The tribe did not depend on manual labor to survive."
      },
      {
        "nome": "Amplifier Glasses",
        "descricao": "Optical devices that enhanced vision for hunting, warfare, and precision craftsmanship."
      },
      {
        "nome": "Xakaxium Metal",
        "descricao": "Metal exclusive to the Xakaxi. Exceptional durability and energy conductivity. Used in weapons and ceremonial items. Vanished after the 1450 sealing."
      },
      {
        "nome": "Nexium Metal",
        "descricao": "Decorative metal used in Xakaxi adornments and jewelry. Nara, the matriarch, wore Nexium jewelry."
      },
      {
        "nome": "The Six Elements",
        "descricao": "Fire, Earth, Air, Water, Light, and Darkness — mastered by the Xakaxi as real spiritual powers. They became the foundation of LDI's elemental system, recreated by Yohualticit centuries later."
      }
    ],
    "povo": [
      {
        "nome": "Chief Xakaxi",
        "papel": "The Great Chief",
        "texto": "He called himself a servant before calling himself chief. Every afternoon he climbed the mountain with his maned wolf to remember what he was for."
      },
      {
        "nome": "Nara",
        "papel": "Warrior and the Chief's wife",
        "texto": "She rode Nhan, a black horse that obeyed no one else. She never knelt to an invader, whether made of flesh or of prophecy."
      },
      {
        "nome": "Pajé Yawanari",
        "papel": "The High Pajé",
        "texto": "He spoke to the gods through the Kumara stone. He gave his own life to seal the sacred power."
      },
      {
        "nome": "Powa",
        "papel": "The Pajé's son",
        "texto": "The most talented. The most impatient. He wanted to use the sacred power as a weapon, and his father forbade it."
      },
      {
        "nome": "Kawa",
        "papel": "Son of Nara and the Chief",
        "texto": "His father's face, his mother's temper. He listened to Powa when he should have listened to his mother."
      },
      {
        "nome": "Ubiratã",
        "papel": "The strongest warrior",
        "texto": "Nobody remembered the last time he smiled. Or the last time anyone knocked him down."
      }
    ]
  },
