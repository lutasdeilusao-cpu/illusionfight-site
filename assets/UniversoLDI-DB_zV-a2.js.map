  "xakaxi": {
    "intro": "En 1450, los Xakaxi eran una civilización indígena siglos adelantada a su tiempo. No eran primitivos — eran avanzados. Hasta que un ritual prohibido lo cambió todo.",
    "tecnologias": [
      {
        "nome": "Fibra de Carbono",
        "descricao": "Material ultraresistente usado en armas y construcción. Exclusivo de la tribu en esa era."
      },
      {
        "nome": "Agricultura Robótica",
        "descricao": "Sistemas automatizados de producción de alimentos. La tribu no dependía del trabajo manual para sobrevivir."
      },
      {
        "nome": "Gafas Amplificadoras",
        "descricao": "Dispositivos ópticos que potenciaban la visión para la caza, la guerra y la artesanía de precisión."
      },
      {
        "nome": "Metal Xakaxium",
        "descricao": "Metal exclusivo de los Xakaxi. Durabilidad excepcional y conductividad energética. Usado en armas y objetos ceremoniales. Desapareció tras el sellado de 1450."
      },
      {
        "nome": "Metal Nexium",
        "descricao": "Metal decorativo usado en adornos y joyas Xakaxi. Nara, la matriarca, llevaba joyas de Nexium."
      },
      {
        "nome": "Los Seis Elementos",
        "descricao": "Fuego, Tierra, Aire, Agua, Luz y Oscuridad — dominados por los Xakaxi como poderes espirituales reales. Se convirtieron en la base del sistema elemental del LDI, recreado por Yohualticit siglos después."
      }
    ],
    "povo": [
      {
        "nome": "Cacique Xakaxi",
        "papel": "El Gran Cacique",
        "texto": "Se llamaba servidor antes de llamarse cacique. Cada tarde subía la montaña con su lobo de crin para recordar para qué servía."
      },
      {
        "nome": "Nara",
        "papel": "Guerrera y esposa del Cacique",
        "texto": "Montaba a Nhan, un caballo negro que solo le obedecía a ella. Nunca se arrodilló ante un invasor, fuera de carne o de profecía."
      },
      {
        "nome": "Pajé Yawanari",
        "papel": "El Pajé Superior",
        "texto": "Hablaba con los dioses a través de la piedra Kumara. Dio su propia vida para sellar el poder sagrado."
      },
      {
        "nome": "Powa",
        "papel": "El hijo del Pajé",
        "texto": "El más talentoso. El más impaciente. Quiso usar el poder sagrado como arma y su padre lo prohibió."
      },
      {
        "nome": "Kawa",
        "papel": "Hijo de Nara y del Cacique",
        "texto": "La cara del padre, el carácter de la madre. Escuchó a Powa cuando debió escuchar a su madre."
      },
      {
        "nome": "Ubiratã",
        "papel": "El guerrero más fuerte",
        "texto": "Nadie recordaba la última vez que sonrió. Ni la última vez que alguien lo derribó."
      }
    ]
  },
