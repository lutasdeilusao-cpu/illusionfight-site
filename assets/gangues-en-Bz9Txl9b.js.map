        "venceu_blocos": [
          "Last one standing is you. The whole pit saw it.",
          "Nato walks in hard, takes the book and tears it page by page in your face.",
          "«You're clean with me. Get lost.»",
          "They blindfold you again. You wake up on some corner of the Strip — body aching, name back to zero."
        ],
        "venceu_blocos_grana": [
          "Last one standing is you.",
          "Nato counts two hundred into your hand. Dry, without looking at you.",
          "«Business is business.»",
          "You got nothing else — nobody leaves the pit smarter, just more marked up. They blindfold you, dump you on the Strip with a heavy pocket."
        ],
        "perdeu_blocos": [
          "The pit floor came up fast.",
          "You wake up later: mattress on the ground, taste of blood, somebody closing your brow with sewing thread.",
          "Nato doesn't even show. He sends word through the muscle.",
          "«The buy-in is debt. And the pit never closes.»"
        ],
        "fuga_blocos": [
          "Jumped the wire mesh before the next one and slipped into the street.",
          "Nobody chased you. No need.",
          "Nato's book is yours now, fat as it got.",
          "«It finds you. At any bar. In any hood.»"
        ],
