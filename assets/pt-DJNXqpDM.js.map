        },
        "2": {
          "nome": "Lona",
          "area": "Arena",
          "desc": "Você aprende no corpo. Apanha, levanta, decora o ritmo de quem bate. No ringue do SDR, quem tem Lona lê a luta antes dela acontecer."
        },
        "3": {
          "nome": "Faro",
          "area": "Investigação",
