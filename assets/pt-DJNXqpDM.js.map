        },
        "22": {
          "nome": "Cair Certo",
          "desc": "Você sabe apanhar: cai sem quebrar e levanta antes do outro esperar.",
          "onde": "Se aprende treinando a Veia no Dia 2, ou no abrigo da Kaeda."
        },
        "23": {
          "nome": "Ler o Golpe",
          "desc": "Você vê o soco nascer no ombro, meio segundo antes dele sair.",
