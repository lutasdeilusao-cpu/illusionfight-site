      "notif_agressivo_fome": "\"me alimenta. agora.\"",
      "notif_agressivo_sede": "\"água. já.\"",
      "notif_agressivo_passeio": "\"se você não me tirar daqui eu destruo tudo aqui dentro\"",
      "notif_agressivo_critico": "\"tô no limite. não tô pedindo. tô avisando.\"",
      "notif_agressivo_morte": "\"...tudo bem. eu entendo. foi bom enquanto durou. seu idiota.\"",
      "notif_fofo_boasvindas": "\"OI! QUE BOM QUE VOCÊ VEIO! TÔ TÃO FELIZ!\"",
      "notif_fofo_fome": "\"oi! tô com fominha! mas tudo bem! você vem logo né? né? né?\"",
      "notif_fofo_sede": "\"aguinha por favor por favor por favor obrigado te amo\"",
      "notif_fofo_passeio": "\"PASSEIO? VAI TER PASSEIO HOJE? pergunta só, sem pressão, mas VAI?\"",
      "notif_fofo_critico": "\"oi... tô um pouquinho mal... mas fico bem quando você chegar tá?\"",
      "notif_fofo_morte": "\"foi tão bom... obrigado por tudo... eu vou sentir saudade... muita saudade...\"",
      "notif_independente_boasvindas": "\"presença registrada. prossiga.\"",
      "notif_independente_fome": "\"alimento necessário.\"",
      "notif_independente_sede": "\"hidratação pendente.\"",
      "notif_independente_passeio": "\"seria útil sair hoje.\"",
      "notif_independente_critico": "\"situação crítica. sua decisão.\"",
      "notif_independente_morte": "\"entendido.\"",
      "notif_filosofo_boasvindas": "\"sua presença levanta questões interessantes. como vai?\"",
      "notif_filosofo_fome": "\"o vazio no estômago é parente do vazio no universo. os dois têm solução.\"",
      "notif_filosofo_sede": "\"a água não pertence a ninguém. mas eu precisaria de um pouco agora.\"",
      "notif_filosofo_passeio": "\"faz tempo que não vejo o céu de Marelia. ou qualquer céu.\"",
      "notif_filosofo_critico": "\"estou chegando numa fronteira interessante. prefiro não atravessá-la hoje.\"",
      "notif_filosofo_morte": "\"a fronteira foi atravessada. não se preocupe. é apenas mais uma jornada.\"",
