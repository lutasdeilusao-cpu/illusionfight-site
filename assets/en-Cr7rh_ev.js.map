      "create_default_name": "Adventurer",
      "char_data": {
        "attr_F": "Power (F): Melee combat damage. Essential in Unarmed and Armed modes. The higher, the more HP you take per attack.",
        "attr_H": "Agility (H): Speed and initiative. Essential for acting first and dodging. Favors Armed mode and increases your FD.",
        "attr_R": "Resistance (R): Your max HP (HP = R × 5). Vital in any mode. Without resistance, you won't last till the end.",
        "attr_A": "Protection (A): Damage reduction and defense. Favors Unarmed mode. Increases your FD and damage resistance.",
        "attr_PdF": "Elemental Power (PdF): Elemental damage and max MP (MP = PdF × 4). Essential in Power mode. Unlocks elemental attacks.",
        "adv_reflexos_rapidos": "Quick Reflexes",
        "adv_reflexos_rapidos_desc": "Your reaction is faster than the LDI average. You gain +1 on initiative rolls and can act first even against faster opponents.",
        "adv_corpo_adaptado": "Adapted Body",
        "adv_corpo_adaptado_desc": "Your body has already adapted to the LDI's rigors. Reduce all physical damage received by 1 point.",
        "adv_sangue_frio": "Cold Blood",
        "adv_sangue_frio_desc": "Extreme situations don't shake you. You ignore penalties from critical HP state and don't suffer fear in combat.",
        "adv_sintonia_elemental": "Elemental Attunement",
        "adv_sintonia_elemental_desc": "Your connection to the element is natural. Your Power attacks cost 1 less MP.",
        "adv_mestre_arma": "Weapon Master",
        "adv_mestre_arma_desc": "With your preferred weapon, you're lethal. +1 damage with your current weapon.",
        "adv_leitura_combate": "Combat Reading",
        "adv_leitura_combate_desc": "You anticipate the enemy's movements. +1 FD against the first attack of each turn.",
        "adv_regeneracao_rapida": "Fast Regeneration",
        "adv_regeneracao_rapida_desc": "Your body recovers faster inside the LDI. Recover 1 HP per combat turn.",
        "adv_foco_mental": "Mental Focus",
        "adv_foco_mental_desc": "Your concentration is a weapon. +1 FA in Power mode.",
        "dis_corpo_fragil": "Fragile Body",
        "dis_corpo_fragil_desc": "Your body doesn't adapt well to the LDI. Your max HP is reduced by 2.",
        "dis_medo_arena": "Arena Fear",
        "dis_medo_arena_desc": "The arena intimidates you. You suffer -1 FA on the first turn of each combat.",
        "dis_impulsivo": "Impulsive",
        "dis_impulsivo_desc": "You act before thinking. Any flee in combat has a chance to fail (roll 1-3 on d6 fails).",
        "dis_sobrecarga_sensorial": "Sensory Overload",
        "dis_sobrecarga_sensorial_desc": "The LDI overwhelms your senses. You lose 1 MP at the start of each combat.",
        "dis_desconfiado": "Suspicious",
        "dis_desconfiado_desc": "You trust few. Some dialogue choices may not be available.",
        "dis_dreno_energetico": "Energy Drain",
        "dis_dreno_energetico_desc": "The system drains your energy. You recover 1 less MP per day.",
        "dis_ataduras_frageis": "Frail Bandages",
        "dis_ataduras_frageis_desc": "Your healing equipment is inefficient. Healing received is reduced by 1.",
        "dis_marca_visivel": "Visible Mark",
        "dis_marca_visivel_desc": "You have a unique digital mark that enemies recognize. Some enemies will be more aggressive.",
        "perk_pericia_katana": "Skill: Katana",
        "perk_pericia_katana_desc": "You know how to use katanas with mastery. Requires Katana equipped. +1 FA in Armed mode with katana.",
