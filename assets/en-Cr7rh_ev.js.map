      "manual": {
        "title": "📖 Game Manual",
        "sections": [
          {
            "title": "What is the LDI?",
            "content": "LDI stands for \"Lutas de Ilusão\" (Illusion Fight), a digital combat system where fighters connect their minds to battle in virtual arenas. You are a new competitor in Arc 1: Discovery."
          },
          {
            "title": "Attributes",
            "content": "F (Power): Melee damage. Favors Unarmed and Armed.\nH (Agility): Initiative and dodge. Favors Armed.\nR (Resistance): Max HP (R × 5). Vital for any style.\nA (Protection): Defense and damage reduction. Favors Unarmed.\nPdF (Elemental Power): Elemental damage and MP (PdF × 4). Essential for Power mode."
          },
          {
            "title": "Combat — Modes",
            "content": "✊ Unarmed: Uses F and A. Moderate damage, high defense.\n⚔️ Armed: Uses F and H. High damage, high initiative.\n⚡ Power: Uses PdF and MP. Elemental damage, consumes MP."
          },
          {
            "title": "Combat — System",
            "content": "Each turn: you attack (FA) and the enemy defends (FD). If FA > FD, you deal damage equal to the difference. Then the enemy attacks. Whoever reduces the opponent's HP to zero first wins."
          },
          {
            "title": "HP and MP",
            "content": "HP (Hit Points): R × 5. If it reaches zero, you lose the combat.\nMP (Magic Points): PdF × 4. Used for Power mode attacks and special actions. Recovers when resting or with items."
          },
          {
            "title": "Powers",
            "content": "You can use up to 4 powers per combat. Each power is a special attack that costs 1 MP. The power type depends on your elemental (Fire, Water, etc.). Powers deal additional damage or special effects."
          },
          {
            "title": "Arcs and Progression",
            "content": "The story is divided into Arcs. Each arc has days. Each day you explore, make choices, and face combat. Your decisions affect the plot, your sheet, and the available endings."
          },
          {
            "title": "Advantages and Disadvantages",
            "content": "Advantages cost creation points. Disadvantages grant extra points to spend on attributes and skills. The total creation points are limited."
          },
          {
            "title": "Survival Tips",
            "content": "1. Don't neglect R — low HP = quick death.\n2. Choose a main combat mode and focus on the right attributes.\n3. Save credits for healing items.\n4. Explore everything — clues reveal secrets and alternate endings.\n5. If you're losing, the option to flee exists for a reason."
          }
        ]
      },
