      "char_data": {
        "attr_F": "Potência (F): Dano em combate corpo a corpo. Essencial no modo Mãos Livres e Armado. Quanto maior, mais PV você tira por ataque.",
        "attr_H": "Agilidade (H): Velocidade e iniciativa. Essencial para agir primeiro e esquivar. Favorece o modo Armado e aumenta sua FD.",
        "attr_R": "Resistência (R): Seu HP máximo (PV = R × 5). Vital em qualquer modo. Sem resistência, você não dura até o final.",
        "attr_A": "Proteção (A): Redução de dano e defesa. Favorece o modo Mãos Livres. Aumenta sua FD e resistência a dano.",
        "attr_PdF": "Poder Elemental (PdF): Dano elemental e PM máximo (PM = PdF × 4). Essencial no modo Poder. Libera ataques elementais.",
        "adv_reflexos_rapidos": "Reflexos Rápidos",
        "adv_reflexos_rapidos_desc": "Sua reação é mais rápida que a média do LDI. Você ganha +1 em rolagens de iniciativa e pode agir primeiro mesmo contra oponentes mais velozes.",
        "adv_corpo_adaptado": "Corpo Adaptado",
        "adv_corpo_adaptado_desc": "Seu corpo já se acostumou com os rigores do LDI. Reduza todo dano físico recebido em 1 ponto.",
        "adv_sangue_frio": "Sangue Frio",
        "adv_sangue_frio_desc": "Situações extremas não te abalam. Você ignora penalidades por estado crítico de PV e não sofre medo em combate.",
        "adv_sintonia_elemental": "Sintonia Elemental",
        "adv_sintonia_elemental_desc": "Sua conexão com o elemento é natural. Seus ataques de Poder custam 1 PM a menos.",
        "adv_mestre_arma": "Mestre de Arma",
        "adv_mestre_arma_desc": "Com sua arma preferida, você é letal. +1 de dano com sua arma atual.",
        "adv_leitura_combate": "Leitura de Combate",
        "adv_leitura_combate_desc": "Você antecipa os movimentos do inimigo. +1 em FD contra o primeiro ataque de cada turno.",
        "adv_regeneracao_rapida": "Regeneração Rápida",
        "adv_regeneracao_rapida_desc": "Seu corpo se recupera mais rápido dentro do LDI. Recupere 1 PV por turno de combate.",
        "adv_foco_mental": "Foco Mental",
        "adv_foco_mental_desc": "Sua concentração é uma arma. +1 em FA no modo Poder.",
        "dis_corpo_fragil": "Corpo Frágil",
        "dis_corpo_fragil_desc": "Seu corpo não se adapta bem ao LDI. Seu PV máximo é reduzido em 2.",
        "dis_medo_arena": "Medo da Arena",
        "dis_medo_arena_desc": "A arena te intimida. Você sofre -1 em FA no primeiro turno de cada combate.",
        "dis_impulsivo": "Impulsivo",
        "dis_impulsivo_desc": "Você age antes de pensar. Toda fuga em combate tem chance de falhar (rolagem 1-3 em d6 falha).",
        "dis_sobrecarga_sensorial": "Sobrecarga Sensorial",
        "dis_sobrecarga_sensorial_desc": "O LDI sobrecarrega seus sentidos. Você perde 1 PM no início de cada combate.",
        "dis_desconfiado": "Desconfiado",
        "dis_desconfiado_desc": "Você confia em poucos. Algumas escolhas de diálogo podem não estar disponíveis.",
        "dis_dreno_energetico": "Dreno Energético",
        "dis_dreno_energetico_desc": "O sistema drena sua energia. Você recupera 1 PM a menos por dia.",
        "dis_ataduras_frageis": "Ataduras Frágeis",
        "dis_ataduras_frageis_desc": "Seus equipamentos de cura são ineficientes. Cura recebida é reduzida em 1.",
        "dis_marca_visivel": "Marca Visível",
        "dis_marca_visivel_desc": "Você tem uma marca digital única que inimigos reconhecem. Alguns inimigos serão mais agressivos.",
        "perk_pericia_katana": "Perícia: Katana",
        "perk_pericia_katana_desc": "Você sabe usar katanas com maestria. Requer Katana equipada. +1 FA no modo Armado com katana.",
        "perk_pericia_laminas": "Perícia: Lâminas Gêmeas",
