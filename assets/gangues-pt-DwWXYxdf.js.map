        "bosses": {
          "fumaca": {
            "nome": "Carvão",
            "fala": "Cê é ligeiro, cria? Eu sou fumaça. Pisca o olho e eu já sumi — e cê apanha no escuro sem nem ver de onde veio o golpe."
          },
          "turco": {
            "nome": "O Cobrador",
            "fala": "Marélia inteira me deve. Agora a {suaGangue} também. E aqui quem não paga em dinheiro paga no osso."
          },
          "espeto": {
            "nome": "Fura-Bucho",
            "fala": "A Baixada é minha desde que o Sombra caiu no valão. Cê tomou meus ponto? Beleza. Vem tomar o resto."
          },
          "sala": {
            "nome": "Ferrugem",
            "fala": "Subiu os dez andar só pra apanhar no último? Respeito a disposição. Não muda merda nenhuma."
          },
          "zefa": {
            "nome": "A Fera",
            "fala": "Eu criei metade da criançada que a {suaGangue} bateu pra chegar aqui. Senta aí. O teu castigo vai demorar."
          },
          "doutor": {
            "nome": "O Contador",
            "fala": "Conta comigo, cria. Cê tem dois lutador. Eu tenho o Alto do Morro inteiro devendo favor. Faz a conta e vai embora."
          },
          "costura": {
            "nome": "O Retalho",
            "fala": "Marélia inteira já foi minha uma vez. Seis quebrada na mão, a Laje no pé. Só que essa porra não costura — nem eu segurei. Sobe aqui que eu te mostro na marra."
          }
        },
        "territorios": {
          "pista": {
            "nome": "A Pista",
            "desc": "O asfalto lá embaixo, cru. Cria correndo atrás de corrente, vendendo bala, virando os olho pra tudo. A Rato de Pista sem sonho grande, o Bonde do Sinal fazendo dinheiro com informação. Ninguém de peso ainda — mas todo dono de bandeira já pisou aqui primeiro. O Retalho pisou. Um moleque chamado Alan também vai pisar, mais pra frente — só que a vez dele ainda nem chegou. Agora é tua vez."
          },
          "feira": {
            "nome": "A Feira",
            "desc": "O comércio, os camelô, a luz de gato. Aqui não tem tiro — tem dívida. O Cobrador anota tudo, e o Cobrador cobra tudo."
          },
          "baixada": {
            "nome": "A Baixada",
            "desc": "Do outro lado da linha do trem. A facção do Sombra rachou em três quando ele morreu. Sangria, Gelo e a Sobra se mordem antes de morder você."
          },
          "vila": {
            "nome": "A Vila",
            "desc": "O conjunto, os prédio de dez andar, a escada sem luz. O bonde controla de baixo pra cima. Pra chegar no dono, sobe tudo apanhando."
          },
          "morro": {
            "nome": "O Morro",
            "desc": "A favela de encosta, a escadaria de cimento que muda de forma a cada laje nova. As boca, os fogueteiro. Quem sobe o Morro não desce igual."
          },
          "alto": {
            "nome": "O Alto do Morro",
            "desc": "Atrás da porta de aço. Os Cinco quase viraram cúpula — juntaram meio Morro numa mão só antes do Retalho chegar e antes de você."
          },
          "laje": {
            "nome": "A Laje",
            "desc": "O topo. De um lado, Marélia inteira olhando. Do outro, o Retalho — o único que já segurou seis quebrada de uma vez. É aqui que se descobre se dá pra segurar sete."
          }
        },
        "falas": {
          "ponto": "{territorio}. Esse ponto é da {gangue}, parça. A {suaGangue} não passa daqui de graça."
        },
        "final": {
          "code": "A SUBIDA ACABA AQUI",
          "titulo": "MARÉLIA NÃO SE COSTURA",
          "paragrafos": [
            "A {gangue} derrubou o Retalho na Laje. Marélia inteira viu.",
            "E aí você entendeu o que ele já sabia. Em duas semana o mapa tava rachado de novo — quebrada puxando pra um lado, boca puxando pra outro. Ninguém segura essa cidade. Nem ele segurou. Nem você.",
            "Anos depois um garoto de cabelo esquisito ia conseguir o que vocês dois não conseguiram. O nome dele era Alan. Mas isso é outra história — e cê tá nela, lá no comecinho."
          ]
        }
