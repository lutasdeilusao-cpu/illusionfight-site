    "duvidas": {
      "eyebrow": "PREGÚNTALE A NEOGUIDE",
      "itens": {
        "o_que_e": {
          "p": "¿Qué es Illusion Fight?",
          "r": "Un universo de acción creado por Isaias Leal. Empezó como libro y creció en webtoon, juegos y banda sonora, todo conectado en el sitio. Tiene tres universos: Lutas de Ilusión, El Mundo de las Sombras y Mar de Cenizas."
        },
        "ano_todo": {
          "p": "¿Hasta cuándo está disponible el área?",
          "r": "Todo el año. Toda la Temporada 1 queda desbloqueada para ti y el área se actualiza con capítulos, arte e ideas nuevas. Vuelve cuando quieras."
        },
        "hiato": {
          "p": "¿Habrá pausas en los lanzamientos?",
          "r": "Sí. Cada tres meses de lanzamientos hay un mes de descanso. En ese mes llegan El Mundo de las Sombras y Mar de Cenizas, historias extra del mismo autor. O sea: nunca te quedas sin contenido."
        },
        "gratis": {
          "p": "¿Es gratis para mi audiencia?",
          "r": "Sí. Los juegos y buena parte de las historias son gratis. Hay una suscripción opcional que adelanta los capítulos. Tú recibes ese acceso anticipado sin pagar nada."
        },
        "posso_falar": {
          "p": "¿Puedo hablar mal?",
          "r": "Sí. La crítica es contenido. Nadie aprueba nada antes y no hay guion."
        },
        "republicar": {
          "p": "¿Qué no puedo hacer?",
          "r": "Volver a publicar contenido completo: un capítulo entero, un episodio entero del webtoon o los archivos originales. Fragmentos, capturas y hasta 3 páginas por publicación están permitidos."
        },
        "prazo": {
          "p": "¿Por cuánto tiempo tengo acceso?",
          "r": "El tiempo aparece arriba, en tu mesa. Depende del tamaño de tu canal, de 1 a 6 meses. Se puede renovar."
        },
        "idiomas": {
          "p": "¿En qué idiomas está?",
          "r": "Español, inglés y portugués. Cambia el idioma en el menú del sitio y todo el contenido cambia con él."
        },
        "lancamento": {
          "p": "¿Cuándo es el lanzamiento?",
          "r": "La Season 1 sale el 30 de noviembre de 2026. Antes, el universo está en el Steam Next Fest, del 19 al 26 de octubre."
        },
        "steam": {
          "p": "¿Qué hay en Steam?",
          "r": "La página de la Season 1 (app 1876210) y la demo gratuita (app 5188520). Agregarla a tu lista de deseados ayuda mucho al proyecto."
        },
        "contato": {
          "p": "¿Cómo hablo con el autor?",
          "r": "Escribe a lutasdeilusao@gmail.com. Entrevistas, dudas, pedido de arte específico: solo pídelo."
        }
      }
    },
    "copiar": {
