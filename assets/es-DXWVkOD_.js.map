    "temas": {
      "acesse": "ENTRA AQUÍ",
      "ano_todo": "Esta área está disponible todo el año, con toda la Temporada 1 desbloqueada para ti, y se va actualizando. Si ahora no es el momento de grabar, vuelve después: habrá algo nuevo esperándote.",
      "itens": {
        "autor": {
          "nome": "La historia del creador",
          "fala": "Isaias Leal pasó casi 10 años en la industria de los videojuegos, trabajó en FNAF: Into the Pit y God of War: Sons of Sparta y lanzó más de 50 títulos. Se fue para construir solo un universo que escribe desde los 17 años. Funciona para canales de detrás de cámaras, carrera y desarrollo independiente, y para quien disfruta historias de gente que lo apostó todo por un proyecto."
        },
        "personagens": {
          "nome": "La vida de los personajes",
          "fala": "Cada personaje principal tiene un pasado contado aparte: Nina, adoptada a los 3 años; Jack, solo desde muy chico, haciendo entregas en bicicleta para sobrevivir. Sirve para videos de análisis, teorías y \"quién es quién\" antes de leer."
        },
        "contos": {
          "nome": "Un cuento para empezar",
          "fala": "Si quieres una historia cerrada, elige un cuento. Alan, el Campeón muestra el crimen organizado de Marelia. Sonata de una Pelea es corto y directo. Las Cadenas explica el poder de Kim. Todos están abiertos ahora."
        },
        "principal": {
          "nome": "La historia principal",
          "fala": "La línea principal es Lutas de Ilusión: Kim, Jack y Nina en un mundo donde las peleas pasan en un simulador y el dolor es real. Tienes 12 capítulos del libro y todo el webtoon terminado antes del lanzamiento. Ideal para lecturas comentadas y primeras impresiones."
        },
        "temporada": {
          "nome": "La Temporada 1 y la agenda",
          "fala": "La Season 1 empieza el 30 de noviembre de 2026, con capítulos saliendo en secuencia. Cada tres meses de lanzamientos hay un mes de pausa, el mes de descanso. En ese mes llega contenido extra del mismo autor: El Mundo de las Sombras y Mar de Cenizas. Por eso existen junto a la línea principal: siempre hay una historia nueva y tienes de qué hablar todo el año."
        },
        "games": {
          "nome": "Juegos",
          "fala": "Tres juegos completos y gratis en el navegador: LDI Gangues (peleas de pandillas por la ciudad), Lendas do LDI (tu Vena cambia la historia) y Top Trumps con modo en línea. Sirve para gameplay, retos con tu audiencia y cobertura del Steam Next Fest."
        },
        "musica": {
          "nome": "Música",
          "fala": "El universo tiene banda sonora original, sonando en Radio Nina dentro del sitio. Y hay un cuento entero sobre la banda de Kim y Jack. Funciona para canales de música, reacciones a la banda sonora y directos con música de fondo."
        },
        "universo": {
          "nome": "El universo completo",
          "fala": "Tres universos del mismo autor: Lutas de Ilusión (acción), El Mundo de las Sombras (terror) y Mar de Cenizas (fantasía oscura). Sirve para videos de lore, comparación y construcción de mundo."
        }
      },
