        "habilidades": "{n} of 3 skills"
      },
      "veias": {
        "1": {
          "nome": "Loose Wire",
          "area": "Code",
          "desc": "You see the seams of the World of Illusions. Locks, passwords, cameras, terminals: to you everything is a question, and every answer is hidden in Yohualticit’s code."
        },
        "2": {
          "nome": "Canvas",
          "area": "Arena",
          "desc": "You learn with your body. Take hits, get up, memorize the rhythm of whoever’s swinging. In the SDR ring, Canvas reads the fight before it happens."
        },
        "3": {
          "nome": "Nose",
          "area": "Investigation",
          "desc": "Nobody lies to someone who knows how to look. You collect clues, cross-check times and distrust anything that looks too clean."
        },
        "4": {
          "nome": "Hustle",
          "area": "Crime and talk",
          "desc": "The streets of Marelia taught you: words open doors keys can’t. You negotiate, bluff and know who knows who."
        },
        "5": {
          "nome": "Static",
          "area": "Attunement",
          "desc": "Someone’s on the other side of the signal. You hear the hiss behind the MDI: the echoes, the old voices, what the system tries to drown out."
        }
      },
      "puzzle": {
        "dificuldade": "Difficulty",
