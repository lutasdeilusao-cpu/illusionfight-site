      "habilidades": {
        "11": {
          "nome": "See the Seams",
          "desc": "You see code leaking out of the edges of things.",
          "onde": "Comes with the Vein, at the Crossroads."
        },
        "12": {
          "nome": "Pull the Wire",
          "desc": "You open panels, locks and system doors by pulling the loose end.",
          "onde": "Learned by training your Vein on Day 2, or at Kaeda’s hideout."
        },
        "13": {
          "nome": "Leave No Trace",
          "desc": "You get into a system and out again without tripping an alarm or leaving a log.",
          "onde": "Someone teaches it on Day 3, or you can train it at Kaeda’s hideout."
        },
        "21": {
          "nome": "Count the Rhythm",
          "desc": "Your body picks up the other guy’s beat before your head does.",
          "onde": "Comes with the Vein, at the Crossroads."
        },
        "22": {
          "nome": "Fall Right",
          "desc": "You know how to take a hit: you go down without breaking and get up before they expect.",
          "onde": "Learned by training your Vein on Day 2, or at Kaeda’s hideout."
        },
        "23": {
          "nome": "Read the Punch",
          "desc": "You see the punch start in the shoulder, half a second before it comes.",
          "onde": "Someone teaches it on Day 3, or you can train it at Kaeda’s hideout."
        },
        "31": {
          "nome": "Notice",
          "desc": "You catch the detail everyone has been trained not to see.",
          "onde": "Comes with the Vein, at the Crossroads."
        },
        "32": {
          "nome": "Read the Log",
          "desc": "You read who got in, when and how, and find what doesn’t add up.",
          "onde": "Learned by training your Vein on Day 2, or at Kaeda’s hideout."
        },
        "33": {
          "nome": "Follow the Money",
          "desc": "People lie, money just moves. You go where it went.",
          "onde": "Someone teaches it on Day 3, or you can train it at Kaeda’s hideout."
        },
        "41": {
          "nome": "Work the Square",
          "desc": "You hang around, laugh at the right joke, and people start talking on their own.",
          "onde": "Comes with the Vein, at the Crossroads."
        },
        "42": {
          "nome": "Grease the Palm",
          "desc": "You know what every mouth costs and pay the right price, not a cent more.",
          "onde": "Learned by training your Vein on Day 2, or at Kaeda’s hideout."
        },
        "43": {
          "nome": "Read the Lie",
          "desc": "You can tell who’s hiding something by the way they hold their phone.",
          "onde": "Someone teaches it on Day 3, or you can train it at Kaeda’s hideout."
        },
        "51": {
          "nome": "Hear the Static",
          "desc": "There’s a voice under the system, and you’re one of the few who hears it.",
          "onde": "Comes with the Vein, at the Crossroads."
        },
        "52": {
          "nome": "Tune In",
          "desc": "You find the static’s frequency and understand what it’s trying to say.",
          "onde": "Learned by training your Vein on Day 2, or at Kaeda’s hideout."
        },
        "53": {
          "nome": "Talk to the Echo",
          "desc": "You answer. And whatever is on the other side of the signal answers back.",
          "onde": "Someone teaches it on Day 3, or you can train it at Kaeda’s hideout."
        }
      },
      "batalha": {
        "lab": "Lab",
        "titulo": "Pentagram Fight",
        "restrito": "Test area, admins only.",
        "como": "Your body is a pentagram: tap the points and each point becomes a strike. The fight has turns: on ATTACK you draw your combo and he tries to block; on DEFENSE he comes at you and you mirror the limbs to block. Block or dodge and the turn flips. All on the beat.",
        "regras": {
          "r1": "Any point, in any order: head, hands, feet, elbows and knees. Tap them one by one on the beat (or drag).",
          "r2": "Up to 4 strikes; the energy is split between them. Tap the last point again to charge: Charge I (up to 2 strikes) and Charge II (1 strike) hit much harder.",
          "r3": "ATTACK: draw your combo; he tries to guess and block. If he blocks nothing, you keep attacking.",
          "r4": "DEFENSE: you know how many strikes are coming (sound and notice). Mirror each strike’s limb, in order, to block. A block always grazes you a little. Block one strike and the turn flips.",
          "r5": "A heavy strike (head, elbow, knee) landing unblocked leaves you dizzy: only 1 strike next time.",
          "r6": "The center lights up green rarely: run your finger through it on defense and you dodge the whole attack, losing no blood, and the turn flips.",
          "r7": "Tap (or hold) the ⚡ orb above the head to fill the power bar. Full, the blue sequence shows up: draw it and Black Ice comes out — heavy damage, unblockable, and he freezes.",
          "r8": "Rhythm is everything: every point has a ring that closes on the beat. Tap as the ring closes — on beat (gold point) the strike hits 25% harder. Off beat is a miss: on attack that strike misses and leaves an opening (the turn flips), but your on-beat strikes land; on defense the block doesn’t count. On defense, each of his strikes shows up on your body on the beat it lands: red got in, gold you blocked. And don’t repeat the same combo 3 times in a row — he reads it."
        },
