        },
        "flags_set": [
          "PISTA_CARGO",
          "SEGUIU_DINHEIRO"
        ],
        "next_scene": "3.4_puzzle_ok"
      },
      {
        "id": "D",
        "label": "Perguntar pro chiado onde ele esconde",
        "requer": {
