      "manual": {
        "fundamentos": {
          "titulo": "Fundamentals",
          "conteudo": "LDI is a virtual combat system where pain is real.\nThree billion players compete for position in the SDR ranking.\nEach fighter chooses a primary elemental that defines their powers."
        },
        "atributos": {
          "titulo": "Attributes",
          "tabela": [
            [
              "F — Power",
              "Melee damage"
            ],
            [
              "H — Agility",
              "Initiative, dodge, speed"
            ],
            [
              "R — Resistance",
              "HP and MP base"
            ],
            [
              "A — Protection",
              "Damage absorption, passive defense"
            ],
            [
              "PdF — Elemental Power",
              "Damage and strength of elemental attacks"
            ]
          ],
          "extra": "Scale: 0 = common | 1 = practitioner | 2 = experienced | 3 = veteran | 4 = elite | 5 = absolute top\nHP = R × 5 | MP = PdF × 5"
        },
        "combate": {
          "titulo": "Battle System",
          "conteudo": "INITIATIVE: H + 1d6 — highest acts first\n\nFA (Melee): F + H + 1d6\nFA (Elemental): PdF + H + 1d6\n\nFD (Normal): A + H + 1d6\nFD (Helpless): A + 1d6\n\nDAMAGE: FA − FD (minimum 0)\nCRITICAL: die = 6 → doubles F, PdF or A"
        },
        "elementais": {
          "titulo": "The 7 Elementals",
          "tabela": [
            [
              "🔥 Fire",
              "Explosive, aggressive. High damage, constant pressure"
            ],
            [
              "💧 Water",
              "Fluid, adaptable. Control, healing, versatility"
            ],
            [
              "🪨 Earth",
              "Solid, resistant. Defense, stun, sustain"
            ],
            [
              "💨 Wind",
              "Fast, evasive. Initiative, evasion, mobility"
            ],
            [
              "🌑 Darkness",
              "Corrosive, draining. Absorption, debuff, weakening"
            ],
            [
              "✨ Light",
              "Purifying, protective. Healing, protection, blindness"
            ],
            [
              "⚪ Neutral",
              "Balanced. Versatile, no weaknesses, no peaks"
            ]
          ]
        },
        "vantagens": {
          "titulo": "Advantages and Disadvantages",
          "conteudo": "Advantages cost character points and represent special techniques and powers.\nDisadvantages grant extra points but impose real restrictions.\n\nThe final balance must be zero: cost of advantages = gain from disadvantages."
        },
        "xp": {
          "titulo": "XP and Evolution",
          "conteudo": "Victory in fair battle: +10 XP\nDefeat in fair battle: +1 XP\n\nEvery 100 XP: 1 character point to spend on attribute or advantage."
        }
      },
