{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Illusion Fight — Season 1 Demo",
  "version": "0.1.0",
  "identifier": "com.illusionfight.steam.demo",
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Illusion Fight — Season 1 Demo",
        "url": "https://illusionfight.com/?client=steam-demo&shellVersion=0.1.0",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "maximized": true,
        "resizable": true,
        "fullscreen": true
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
